# tarka benchmarks — the hot paths at the demo's dimensions, plus one larger shape.
#
# Run as CI does: `CYRIUS_DCE=1 cyrius bench tests/tarka.bcyr`.
# scripts/bench-history.sh runs this file RUNS times and appends the medians to
# bench-history.csv. Every row seeds its own policy, so each run times the same work.
# Setup (pol_init, reward-model training, corpus) stays outside the timed windows.
#
# The demo's policy shape is V=28 (the corpus's byte vocab), D=8, T=24; the parity,
# reasoning and search tasks use V=12, D=8, T=16. "V256 D64" rows show how the kernels
# scale once linear_fwd / linear_bwd dominate.

include "lib/tyche.cyr"
include "lib/rosnet.cyr"
include "lib/akshara.cyr"
include "src/rl.cyr"
include "src/actorcritic.cyr"
include "src/parity.cyr"
include "src/reward.cyr"
include "src/dpo.cyr"
include "src/preference_ext.cyr"
include "src/preference.cyr"
include "src/reasoning.cyr"
include "src/search.cyr"
include "src/mcts.cyr"
include "src/chance.cyr"
include "src/report.cyr"
include "src/pref_ingest.cyr"

fn _putc(ch): i64 { var b[8]; store8(&b, ch); sys_write(1, &b, 1); return 0; }
fn puts(s): i64 { var n = 0; while (load8(s + n) != 0) { n = n + 1; } print(s, n); return 0; }
fn secure_read_file(path, buf, cap): i64 { return 0 - 1; }
fn read_stdin(buf, cap): i64 { return 0 - 1; }
fn file_seek(fd, off): i64 { return 0 - 1; }

fn LR(): i64 { return f64_div(f64_from(5), f64_from(100)); }

# one policy forward (pol_logits + pol_softmax), batched
fn bench_forward(name, V, D, iters): i64 {
    pol_init(V, D, 24, 3, 1); g_datalen = 0;
    var b = bench_new(name);
    bench_batch_start(b);
    var i = 0;
    while (i < iters) { pol_logits(i % V); pol_softmax(); i = i + 1; }
    bench_batch_stop(b, iters);
    bench_report(b);
    return 0;
}

# one T=24 on-policy rollout
fn bench_rollout(name, V, D, iters): i64 {
    pol_init(V, D, 24, 3, 2); g_datalen = 0;
    var b = bench_new(name);
    bench_batch_start(b);
    var i = 0;
    while (i < iters) { rl_rollout(i % V); i = i + 1; }
    bench_batch_stop(b, iters);
    bench_report(b);
    return 0;
}

# rl_backward over one stored T=24 rollout (gradient accumulation only)
fn bench_backward(name, V, D, iters): i64 {
    pol_init(V, D, 24, 3, 3); g_datalen = 0;
    rl_rollout(1);
    var b = bench_new(name);
    bench_batch_start(b);
    var i = 0;
    while (i < iters) { rl_backward(f64_from(1)); i = i + 1; }
    bench_batch_stop(b, iters);
    bench_report(b);
    return 0;
}

# one Adam step over the policy's three blocks
fn bench_adam(name, V, D, iters): i64 {
    pol_init(V, D, 24, 3, 4); g_datalen = 0;
    var b = bench_new(name);
    bench_batch_start(b);
    var i = 0;
    while (i < iters) { pol_adam_step(LR()); i = i + 1; }
    bench_batch_stop(b, iters);
    bench_report(b);
    return 0;
}

# full training steps: the end-to-end rows (each a whole optimizer step)
fn bench_reinforce_step(): i64 {
    pol_init(28, 8, 24, 3, 5); g_datalen = 0;
    var b = bench_new("REINFORCE step (batch 16, T 24, V28 D8)");
    bench_batch_start(b);
    rl_train(20, 16, LR(), 0);
    bench_batch_stop(b, 20);
    bench_report(b);
    return 0;
}
fn bench_ppo_step(): i64 {
    pol_init(28, 8, 24, 3, 6); ac_init(); g_datalen = 0;
    var b = bench_new("PPO step (4 epochs, T 24, V28 D8)");
    bench_batch_start(b);
    ppo_train(40, 4, LR(), 0);
    bench_batch_stop(b, 40);
    bench_report(b);
    return 0;
}
fn bench_grpo_step(): i64 {
    pol_init(28, 8, 24, 3, 7); ac_init(); g_datalen = 0;
    var b = bench_new("GRPO step (group 8, T 24, V28 D8)");
    bench_batch_start(b);
    grpo_train(20, 8, LR(), 0);
    bench_batch_stop(b, 20);
    bench_report(b);
    return 0;
}
fn bench_prm_step(): i64 {
    pol_init(12, 8, 16, 2, 8); rm_init(); g_decoy = 3; g_datalen = 0;
    var b = bench_new("PRM step (batch 16, V12 D8)");
    bench_batch_start(b);
    rm_train_prm(50, 16, LR());
    bench_batch_stop(b, 50);
    bench_report(b);
    return 0;
}
fn bench_dpo_step(): i64 {
    pol_init(28, 8, 24, 3, 9); dpo_init(); dpo_snapshot(); g_datalen = 0;
    var b = bench_new("DPO step (batch 16, T 24, V28 D8)");
    bench_batch_start(b);
    dpo_train(10, 16, LR());
    bench_batch_stop(b, 10);
    bench_report(b);
    return 0;
}
fn bench_kto_step(): i64 {
    pol_init(28, 8, 24, 3, 10); dpo_init(); dpo_snapshot(); g_datalen = 0;
    var b = bench_new("KTO step (batch 16, T 24, V28 D8)");
    bench_batch_start(b);
    kto_train(10, 16, LR());
    bench_batch_stop(b, 10);
    bench_report(b);
    return 0;
}
fn bench_beam(): i64 {
    search_setup(); search_init();
    var b = bench_new("beam search B8 K8 (per prompt, T 16)");
    bench_batch_start(b);
    srch_beam(8, 8, 20, 2000);
    bench_batch_stop(b, 20);
    bench_report(b);
    return 0;
}

# prior-guided MCTS and the prior + value beam on the corridor, per prompt
fn bench_mcts(): i64 {
    mcts_setup();
    var b = bench_new("MCTS PUCT S512 (per prompt, corridor)");
    bench_batch_start(b);
    mc_mcts(512, f64_from(1), 10, 2000);
    bench_batch_stop(b, 10);
    bench_report(b);
    var b2 = bench_new("beam prior+value B4 K4 (per prompt, corridor)");
    bench_batch_start(b2);
    mc_beam(4, 4, 3, 10, 2000);
    bench_batch_stop(b2, 10);
    bench_report(b2);
    return 0;
}

# pref ingestion: parse throughput over a generated ~1 MB JSONL (pairs + thumbs)
fn bench_pref_parse(): i64 {
    var cap = PI_FMAX();
    var buf = alloc(cap + 1);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"kind\":\"pair\",\"prompt\":\"what is the answer\",");
    str_builder_add_cstr(sb, "\"chosen\":\"the right one\",\"rejected\":\"a wrong one\"}\n");
    str_builder_add_cstr(sb, "{\"kind\":\"unary\",\"prompt\":\"rate it\",");
    str_builder_add_cstr(sb, "\"completion\":\"nice and clear\",\"label\":1}\n");
    var rs = str_builder_build(sb);
    var row = str_data(rs); var rl = str_len(rs);
    var n = 0;
    while (n + rl <= cap) { memcpy(buf + n, row, rl); n = n + rl; }
    corpus_set(buf, n);
    pol_init(g_corpus_vlen, 8, 16, 0, 11);
    var b = bench_new("pref_ingest_file ~1MB JSONL");
    var it = 0;
    while (it < 5) {
        bench_start(b);
        pref_ingest_file(buf, n);
        bench_stop(b);
        it = it + 1;
    }
    bench_report(b);
    g_datalen = 0;
    return 0;
}

# MCTS under chance (1.6.0): MCTS and the beam per closed-loop episode, and the distillation
fn bench_chance(): i64 {
    chance_setup();
    var b = bench_new("MCTS chance nodes S128 (per episode, casino)");
    bench_batch_start(b);
    ch_mcts(128, f64_from(1), 10, 2000);
    bench_batch_stop(b, 10);
    bench_report(b);
    var b2 = bench_new("beam B16 K4 under chance (per episode, casino)");
    bench_batch_start(b2);
    ch_beam(16, 4, 1, 10, 2000);
    bench_batch_stop(b2, 10);
    bench_report(b2);
    ch_exit_collect(128, f64_from(1), 32, 9000, 1);
    var b3 = bench_new("expert iteration, 512 records (per epoch)");
    bench_batch_start(b3);
    ch_exit_train(50, LR());
    bench_batch_stop(b3, 50);
    bench_report(b3);
    return 0;
}

# --gpu (1.5.0): one logits table (every state's logits) row by row on the CPU, and as one
# device dispatch. Without a device the device rows are skipped (a decline costs nothing).
fn bench_table(V, D, iters, cpu_name, gpu_name, have): i64 {
    pol_init(V, D, 24, 3, 7); g_datalen = 0;
    var Y = t_alloc(V * V);
    var b = bench_new(cpu_name);
    bench_batch_start(b);
    var i = 0;
    while (i < iters) { var x = 0; while (x < V) { pol_logits(x); x = x + 1; } i = i + 1; }
    bench_batch_stop(b, iters);
    bench_report(b);
    if (have == 0) { return 0; }
    g_gpu = 1;
    var b2 = bench_new(gpu_name);
    bench_batch_start(b2);
    i = 0;
    while (i < iters) { dev_table(P_E, P_W, P_b, Y); i = i + 1; }
    bench_batch_stop(b2, iters);
    bench_report(b2);
    g_gpu = 0;
    return 0;
}

fn bench_gpu(): i64 {
    var have = 0; if (gpu_probe() == 0) { have = 1; }
    bench_table(28, 8, 2000, "logits table V28 D8 (CPU, 28 rows)", "logits table V28 D8 (gpu, one dispatch)", have);
    bench_table(92, 16, 300, "logits table V92 D16 (CPU, 92 rows)", "logits table V92 D16 (gpu, one dispatch)", have);
    if (have == 0) { puts("  (no device: the --gpu rows are skipped)\n"); return 0; }
    pol_init(28, 8, 24, 3, 5); g_datalen = 0;
    g_gpu = 1;
    var b = bench_new("REINFORCE step under gpu (batch 16, T 24, V28 D8)");
    bench_batch_start(b);
    rl_train(20, 16, LR(), 0);
    bench_batch_stop(b, 20);
    bench_report(b);
    g_gpu = 0;
    return 0;
}

fn main(): i64 {
    alloc_init();
    bench_forward("forward V28 D8", 28, 8, 200000);
    bench_forward("forward V256 D64", 256, 64, 5000);
    bench_rollout("rollout T24 V28 D8", 28, 8, 5000);
    bench_backward("rl_backward T24 V28 D8", 28, 8, 3000);
    bench_backward("rl_backward T24 V256 D64", 256, 64, 40);
    bench_adam("adam step V28 D8", 28, 8, 20000);
    bench_adam("adam step V256 D64", 256, 64, 300);
    bench_reinforce_step();
    bench_ppo_step();
    bench_grpo_step();
    bench_prm_step();
    bench_dpo_step();
    bench_kto_step();
    bench_beam();
    bench_mcts();
    bench_chance();
    bench_gpu();
    bench_pref_parse();
    return 0;
}

var r = main();
sys_exit(r);
