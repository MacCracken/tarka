# tarka — unit suite: the distribution memo's invalidation rules, the parity / reasoning
# / search helpers, GAE normalization, GRPO's degenerate group, and the self-resizing
# buffers. (The grad-checks live in tests/tarka.tcyr, ingestion in tests/pref_ingest.tcyr,
# the bit-for-bit gate in tests/golden.tcyr.)

include "lib/tyche.cyr"
include "lib/rosnet.cyr"
include "lib/akshara.cyr"
include "src/rl.cyr"
include "src/actorcritic.cyr"
include "src/parity.cyr"
include "src/reward.cyr"
include "src/dpo.cyr"
include "src/preference_ext.cyr"
include "src/preference.cyr"
include "src/reasoning.cyr"
include "src/search.cyr"
include "src/mcts.cyr"
include "src/chance.cyr"

fn _putc(ch): i64 { var b[8]; store8(&b, ch); sys_write(1, &b, 1); return 0; }
fn puts(s): i64 { var n = 0; while (load8(s + n) != 0) { n = n + 1; } print(s, n); return 0; }
fn secure_read_file(path, buf, cap): i64 { return 0 - 1; }
fn read_stdin(buf, cap): i64 { return 0 - 1; }
fn file_seek(fd, off): i64 { return 0 - 1; }

fn LR(): i64 { return f64_div(f64_from(5), f64_from(100)); }

# 1 if the V-entry f64 blocks a and b hold the same bits
fn same_bits(a, b, n): i64 {
    var i = 0;
    while (i < n) { if (load64(a + i * 8) != load64(b + i * 8)) { return 0; } i = i + 1; }
    return 1;
}

# pi(.|x) computed directly (no memo), into dst
fn direct_dist(x, dst): i64 { pol_logits(x); pol_softmax(); t_copy(dst, S_probs, g_V); return 0; }

# ---- the memo ---------------------------------------------------------------------
fn test_memo_hit_equals_compute(): i64 {
    pol_init(9, 4, 6, 2, 11); g_datalen = 0;
    var want = t_alloc(9); var got = t_alloc(9);
    memo_begin();
    var x = 0; var ok = 1;
    while (x < 9) {
        pol_dist(x); t_copy(got, S_probs, 9);            # miss: fills row x
        pol_dist(x);                                     # hit
        if (same_bits(got, S_probs, 9) == 0) { ok = 0; }
        x = x + 1;
    }
    memo_end();
    x = 0;
    while (x < 9) {
        direct_dist(x, want);
        memo_begin(); pol_dist(x); memo_end();
        if (same_bits(want, S_probs, 9) == 0) { ok = 0; }
        x = x + 1;
    }
    assert_eq(ok, 1, "memo: a hit has the bits of a fresh computation");
    return 0;
}

fn test_memo_adam_retires_rows(): i64 {
    pol_init(7, 4, 6, 2, 12); g_datalen = 0;
    var before = t_alloc(7); var want = t_alloc(7);
    memo_begin();
    pol_dist(3); t_copy(before, S_probs, 7);
    rl_rollout(3); pol_zero_grads(); rl_backward(f64_from(1)); pol_adam_step(LR());
    pol_dist(3);
    memo_end();
    direct_dist(3, want);
    assert_eq(same_bits(want, S_probs, 7), 1, "memo: after pol_adam_step the row is recomputed");
    assert_eq(same_bits(before, S_probs, 7), 0, "memo: and the parameters did move it");
    return 0;
}

fn test_memo_external_write_between_regions(): i64 {
    pol_init(7, 4, 6, 2, 13); g_datalen = 0;
    var want = t_alloc(7);
    memo_begin(); pol_dist(4); memo_end();               # row 4 cached
    store64(P_b + 4 * 8, f64_add(load64(P_b + 4 * 8), f64_from(3)));   # a direct write, as the FD checks do
    direct_dist(4, want);
    memo_begin(); pol_dist(4); memo_end();
    assert_eq(same_bits(want, S_probs, 7), 1, "memo: a new region never serves a row filled before it");
    return 0;
}

fn test_memo_nesting(): i64 {
    pol_init(5, 4, 6, 2, 14); g_datalen = 0;
    memo_begin(); memo_begin(); memo_end();
    assert_eq(g_memo_depth, 1, "memo: an inner end leaves the outer region open");
    memo_end();
    assert_eq(g_memo_depth, 0, "memo: balanced");
    var e0 = PM_epoch;
    rl_train(2, 2, LR(), 0);
    assert_eq(g_memo_depth, 0, "memo: rl_train leaves no region open");
    assert(PM_epoch > e0, "memo: training advanced the policy version");
    return 0;
}

fn test_memo_reference_and_rm(): i64 {
    pol_init(6, 4, 6, 2, 15); dpo_init(); dpo_snapshot(); rm_init(); g_datalen = 0;
    var want = t_alloc(6); var before = t_alloc(6);
    memo_begin();
    ref_dist(2); t_copy(before, S_refprobs, 6);          # row 2 cached
    store64(P_b + 2 * 8, f64_from(5));                   # move the policy, then re-snapshot it,
    dpo_snapshot();                                      # inside the same region
    ref_dist(2);
    memo_end();
    t_copy(want, S_refprobs, 6);
    ref_logits(2); ref_softmax();
    assert_eq(same_bits(want, S_refprobs, 6), 1, "memo: dpo_snapshot retires the reference's rows");
    assert_eq(same_bits(before, want, 6), 0, "memo: and the snapshot did move the reference");
    memo_begin();
    var r0 = rm_reward(1, 3);
    rm_zero_grads(); store64(G_br + 3 * 8, f64_from(1)); rm_adam_step(LR());
    var r1 = rm_reward(1, 3);
    memo_end();
    rm_logits(1);
    assert_eq(r1, load64(S_rlogits + 3 * 8), "memo: rm_adam_step retires the RM's rows");
    assert(r1 != r0, "memo: and the RM did move");
    return 0;
}

# ---- parity / reasoning / search helpers ------------------------------------------
fn test_parity_reward(): i64 {
    pol_init(BENCH_V(), BENCH_D(), BENCH_T(), BENCH_TGT(), 21); g_decoy = BENCH_DECOY(); g_datalen = 0;
    assert_eq(par_rw(4, BENCH_TGT()), f64_from(1), "even state, target action: 1");
    assert_eq(par_rw(5, BENCH_TGT()), f64_from(0), "odd state, target action: 0");
    assert_eq(par_rw(5, BENCH_DECOY()), f64_from(1), "odd state, decoy action: 1");
    assert_eq(par_rw(4, BENCH_DECOY()), f64_from(0), "even state, decoy action: 0");
    assert_eq(par_rw(4, 7), f64_from(0), "any other action: 0");
    assert_eq(par_correct(6), BENCH_TGT(), "par_correct even -> target");
    assert_eq(par_correct(7), BENCH_DECOY(), "par_correct odd -> decoy");
    var k = 0; var ok = 1;
    while (k < 500) { var x = k % BENCH_V(); if (par_wrong(x) == par_correct(x)) { ok = 0; } k = k + 1; }
    assert_eq(ok, 1, "par_wrong never returns the correct action");
    rl_rollout(3);
    var s = f64_from(0); var t = 0;
    while (t < g_T) { s = f64_add(s, par_rw(load64(R_states + t * 8), load64(R_actions + t * 8))); t = t + 1; }
    assert_eq(par_rollout_reward(), s, "par_rollout_reward = sum of par_rw");
    return 0;
}

fn test_reasoning_answer(): i64 {
    pol_init(REASON_V(), REASON_D(), REASON_T(), REASON_TGT(), 22);
    assert_eq(reason_oracle(4), REASON_TGT(), "oracle: even prompt -> TGT");
    assert_eq(reason_oracle(5), REASON_DECOY(), "oracle: odd prompt -> DECOY");
    var t = 0;
    while (t < g_T) { store64(R_states + t * 8, 2 * (t % 3)); t = t + 1; }              # all even
    assert_eq(reason_answer(), REASON_TGT(), "all-even chain -> TGT");
    t = 0;
    while (t < g_T) { store64(R_states + t * 8, 2 * t + 1); t = t + 1; }                # all odd
    assert_eq(reason_answer(), REASON_DECOY(), "all-odd chain -> DECOY");
    t = 0;
    while (t < g_T) { store64(R_states + t * 8, t); t = t + 1; }                        # half and half
    assert_eq(reason_answer(), REASON_TGT(), "a tie breaks to TGT");
    return 0;
}

fn test_search_helpers(): i64 {
    pol_init(SR_V(), SR_D(), SR_T(), TARGET(), 23); g_datalen = 0;
    var t = 0;
    while (t < g_T) { var a = 1; if ((t % 4) == 0) { a = TARGET(); } store64(R_actions + t * 8, a); t = t + 1; }
    assert_eq(target_streak(R_states, R_actions), f64_from(4), "target_streak counts TARGET actions");
    t_zero(P_W, g_D * g_V); t_zero(P_b, g_V); store64(P_b + 7 * 8, f64_from(1));
    assert_eq(pol_argmax(3), 7, "pol_argmax picks the largest logit");
    return 0;
}

# beam search with one beam and one child samples exactly as best-of-1: same RNG draws,
# same actions, same forward count
fn test_beam_1x1_is_best_of_1(): i64 {
    search_setup();
    g_fwd = 0; var b = srch_best_of_n(1, 12, 3000); var fb = g_fwd;
    g_fwd = 0; var m = srch_beam(1, 1, 12, 3000); var fm = g_fwd;
    assert_eq(m, b, "beam(1,1) == best-of-1");
    assert_eq(fm, fb, "beam(1,1) runs the same forward count");
    return 0;
}

# ---- GAE / GRPO -------------------------------------------------------------------
fn test_gae_normalize(): i64 {
    pol_init(6, 4, 8, 2, 24); ac_init();
    var t = 0;
    while (t < g_T) { store64(R_adv + t * 8, f64_from(t * 3 + 1)); t = t + 1; }
    gae_normalize();
    var mean = f64_div(t_sum(R_adv, g_T), f64_from(g_T));
    var var0 = f64_from(0); t = 0;
    while (t < g_T) { var d = load64(R_adv + t * 8); var0 = f64_add(var0, f64_mul(d, d)); t = t + 1; }
    var sd = f64_sqrt(f64_div(var0, f64_from(g_T)));
    var tiny = f64_div(f64_from(1), f64_from(1000000));
    assert(f64_lt(f64_abs(mean), tiny) == 1, "normalized advantages: mean 0");
    assert(f64_lt(f64_abs(f64_sub(sd, f64_from(1))), tiny) == 1, "normalized advantages: std 1");
    t = 0;
    while (t < g_T) { store64(R_adv + t * 8, f64_from(5)); t = t + 1; }
    gae_normalize();
    assert_eq(load64(R_adv + 3 * 8), f64_from(5), "constant advantages: left as they are");
    return 0;
}

fn test_grpo_equal_group(): i64 {
    pol_init(6, 4, 8, 2, 25); ac_init();
    var g = 0;
    while (g < 4) { store64(GR_R + g * 8, f64_from(7)); g = g + 1; }
    grpo_group_adv(4);
    var ok = 1; g = 0;
    while (g < 4) { if (f64_eq(load64(GR_adv + g * 8), f64_from(0)) == 0) { ok = 0; } g = g + 1; }
    assert_eq(ok, 1, "an all-equal group has advantage exactly 0 (no NaN)");
    return 0;
}

# ---- buffers follow the rollout length ----------------------------------------------
fn test_buffers_resize(): i64 {
    pol_init(8, 4, 4, 2, 26); dpo_init(); dpo_snapshot(); g_datalen = 0;
    dpo_train(1, 2, LR());
    assert_eq(DAB_T, 4, "slot buffers sized for T=4");
    pol_init(8, 4, 20, 2, 27); dpo_init(); dpo_snapshot();
    dpo_train(1, 2, LR());
    assert_eq(DAB_T, 20, "slot buffers re-sized for T=20");
    kto_train(1, 2, LR());
    assert_eq(KA_T, 20, "KTO batch buffers sized for T=20");
    pol_init(12, 8, 16, 2, 28); ac_init(); rm_init(); g_decoy = 3;
    rm_train_orm(1, 2, LR());
    assert_eq(OAB_T, 16, "ORM rollout-pair buffers sized for T=16");
    return 0;
}

# ---- the aggregated backward (1.3.0) ---------------------------------------------------
# the largest relative difference between two n-entry f64 blocks
fn max_rel(a, b, n): i64 {
    var mr = f64_from(0); var i = 0;
    var floor = f64_div(f64_from(1), f64_from(1000000000));
    while (i < n) {
        var x = load64(a + i * 8); var y = load64(b + i * 8);
        var d = f64_div(f64_abs(f64_sub(x, y)), f64_add(f64_abs(y), floor));
        if (f64_gt(d, mr) == 1) { mr = d; }
        i = i + 1;
    }
    return mr;
}

fn test_aggregated_backward(): i64 {
    pol_init(9, 4, 12, 2, 31); g_datalen = 0;      # T 12 over V 9: some state repeats
    rl_rollout(4);
    var adv = f64_div(f64_from(3), f64_from(2));
    pol_zero_grads(); rl_backward(adv);             # outside a region: per-token, immediate
    var iW = t_alloc(g_D * g_V); var ib = t_alloc(g_V); var iE = t_alloc(g_V * g_D);
    t_copy(iW, G_W, g_D * g_V); t_copy(ib, G_b, g_V); t_copy(iE, G_E, g_V * g_D);
    memo_begin();
    pol_zero_grads(); rl_backward(adv);             # inside: deferred per state
    assert((PB_n >= 1) && (PB_n < g_T), "deferred: fewer pending rows than tokens (a state repeated)");
    pol_bwd_flush();
    memo_end();
    var tight = f64_div(f64_from(1), f64_from(1000000000000));     # 1e-12
    assert(f64_lt(max_rel(G_W, iW, g_D * g_V), tight) == 1, "aggregated dW == per-token dW (1e-12)");
    assert(f64_lt(max_rel(G_b, ib, g_V), tight) == 1, "aggregated db == per-token db (1e-12)");
    assert(f64_lt(max_rel(G_E, iE, g_V * g_D), tight) == 1, "aggregated dE == per-token dE (1e-12)");
    memo_begin();
    pol_zero_grads(); rl_backward(adv);
    pol_zero_grads();                               # discards the pending rows
    assert_eq(PB_n, 0, "pol_zero_grads drops the pending rows");
    var z = 0; var i = 0;
    while (i < g_D * g_V) { if (load64(G_W + i * 8) != 0) { z = 1; } i = i + 1; }
    assert_eq(z, 0, "and leaves the gradient zero");
    memo_end();
    return 0;
}

# ---- MCTS (1.4.0): the corridor's reward and optimum, the demonstrator, the tree's books --
fn test_mc_reward(): i64 {
    pol_init(MC_V(), MC_D(), MC_T(), MC_TRAP(), 41); g_datalen = 0;
    assert_eq(mc_true_r(7, MC_TRAP()), f64_from(1), "TRAP: +1 from anywhere");
    assert_eq(mc_true_r(7, MC_K1()), f64_from(0), "K1: 0 from anywhere");
    assert_eq(mc_true_r(MC_K1(), MC_K2()), f64_from(0), "K2 after K1: 0");
    assert_eq(mc_true_r(7, MC_K2()), MC_PEN(), "K2 out of order: the penalty");
    assert_eq(mc_true_r(MC_K2(), MC_K3()), f64_from(0), "K3 after K2: 0");
    assert_eq(mc_true_r(MC_K1(), MC_K3()), MC_PEN(), "K3 out of order: the penalty");
    assert_eq(mc_true_r(MC_K3(), MC_GOAL()), f64_from(4), "GOAL after K3: +4");
    assert_eq(mc_true_r(MC_GOAL(), MC_GOAL()), f64_from(4), "GOAL after GOAL: +4");
    assert_eq(mc_true_r(MC_TRAP(), MC_GOAL()), MC_PEN(), "GOAL out of order: the penalty");
    assert_eq(mc_true_r(7, 9), f64_from(0), "a neutral token: 0");
    return 0;
}

fn test_mc_oracle(): i64 {
    pol_init(MC_V(), MC_D(), MC_T(), MC_TRAP(), 42); g_datalen = 0;
    assert_eq(mc_oracle_from(0), f64_from(52), "optimum from a neutral prompt: K1 K2 K3 GOAL x13 = 52");
    assert_eq(mc_oracle_from(MC_TRAP()), f64_from(52), "from TRAP: 52");
    assert_eq(mc_oracle_from(MC_K1()), f64_from(56), "from K1: 56");
    assert_eq(mc_oracle_from(MC_K2()), f64_from(60), "from K2: 60");
    assert_eq(mc_oracle_from(MC_K3()), f64_from(64), "from K3: 64");
    assert_eq(mc_oracle_from(MC_GOAL()), f64_from(64), "from GOAL: 64");
    mc_demo(0, 1, 0);                               # a solver demonstration without noise
    assert_eq(load64(R_actions), MC_K1(), "the solver opens with K1");
    assert_eq(load64(R_actions + 8), MC_K2(), "then K2");
    assert_eq(load64(R_actions + 16), MC_K3(), "then K3");
    assert_eq(load64(R_actions + 24), MC_GOAL(), "then GOAL");
    assert_eq(mc_true_return(R_states, R_actions), f64_from(52), "and earns the optimum");
    mc_demo(0, 0, 0);
    assert_eq(mc_true_return(R_states, R_actions), f64_from(16), "a TRAP demonstration earns 16");
    return 0;
}

fn test_mc_sort(): i64 {
    var key = t_alloc(6); var ix = t_alloc(6); var tmp = t_alloc(6);
    store64(key, f64_from(2)); store64(key + 8, f64_from(5)); store64(key + 16, f64_from(2));
    store64(key + 24, f64_from(9)); store64(key + 32, f64_from(5)); store64(key + 40, f64_from(0 - 1));
    var i = 0; while (i < 6) { store64(ix + i * 8, i); i = i + 1; }
    mc_sort_desc(ix, 6, key, tmp);
    assert_eq(load64(ix), 3, "sort: 9 first");
    assert_eq(load64(ix + 8), 1, "then the first 5");
    assert_eq(load64(ix + 16), 4, "then the second 5 (stable)");
    assert_eq(load64(ix + 24), 0, "then the first 2");
    assert_eq(load64(ix + 32), 2, "then the second 2 (stable)");
    assert_eq(load64(ix + 40), 5, "then -1");
    return 0;
}

fn test_mc_tree_books(): i64 {
    mcts_setup_n(20, 20, 43);
    MC_nn = 0;
    var root = mc_node(0, 0, f64_from(0));
    var S = 40; var s = 0;
    while (s < S) { mc_simulate(root, f64_from(1)); s = s + 1; }
    assert_eq(load64(ND_N + root * 8), S, "every simulation visits the root");
    var sum = 0; var a = 0; var most = 0 - 1; var mostn = 0 - 1;
    while (a < g_V) {
        var k = load64(ND_kid + (root * g_V + a) * 8);
        if (k >= 0) {
            var nk = load64(ND_N + k * 8); sum = sum + nk;
            if (nk > mostn) { mostn = nk; most = k; }
        }
        a = a + 1;
    }
    assert_eq(sum, S - 1, "the root's children share every visit but the expanding one");
    assert_eq(load64(ND_N + mc_commit_child(root) * 8), mostn, "the committed child is the most visited");
    return 0;
}

# ---- the casino corridor (1.6.0) ------------------------------------------------
fn test_ch_reward(): i64 {
    pol_init(MC_V(), MC_D(), MC_T(), MC_TRAP(), 51); g_datalen = 0; ch_set_q(CH_Q());
    var G = CH_GAMBLE(); var J = CH_JACK(); var B = CH_BUST();
    assert_eq(ch_r(0, G, J), f64_from(0), "chance: a jackpot costs nothing");
    assert_eq(ch_r(0, G, B), f64_from(0 - 8), "chance: a bust costs CH_LOSS");
    assert_eq(ch_r(J, MC_GOAL(), MC_GOAL()), f64_from(4), "chance: a jackpot opens GOAL");
    assert_eq(ch_r(B, MC_GOAL(), MC_GOAL()), MC_PEN(), "chance: a bust does not");
    assert_eq(ch_r(0, J, J), MC_PEN(), "chance: JACKPOT is reached only by gambling");
    assert_eq(ch_r(0, B, B), MC_PEN(), "chance: and BUST");
    assert_eq(ch_r(MC_K1(), MC_K2(), MC_K2()), f64_from(0), "chance: the corridor is unchanged");
    assert_eq(ch_next(G, 249), J, "chance: u < q is a jackpot");
    assert_eq(ch_next(G, 250), B, "chance: u >= q is a bust");
    assert_eq(ch_next(MC_TRAP(), 0), MC_TRAP(), "chance: every other action is deterministic");
    return 0;
}

fn test_ch_env(): i64 {
    var ok = 1; var same = 1; var jack = 0; var e = 0;
    while (e < 200) {
        var t = 0;
        while (t < 16) {
            var u = ch_env_u(e, t);
            if ((u < 0) || (u >= 1000)) { ok = 0; }
            rng_seed(e + t);                              # the planner's RNG does not move it
            RUNI();
            if (ch_env_u(e, t) != u) { same = 0; }
            if (u < 250) { jack = jack + 1; }
            t = t + 1;
        }
        e = e + 1;
    }
    assert_eq(ok, 1, "chance: the real stream draws 0..999");
    assert_eq(same, 1, "chance: the real stream depends on (episode, step) alone");
    assert((jack > 700) && (jack < 900), "chance: about a quarter of 3,200 real draws are jackpots");
    return 0;
}

fn test_ch_oracle(): i64 {
    pol_init(MC_V(), MC_D(), MC_T(), MC_TRAP(), 52); g_datalen = 0; ch_set_q(CH_Q());
    assert_eq(ch_oracle_from(0), f64_from(52), "chance: the corridor is optimal from a neutral token (52)");
    assert_eq(ch_qval(0, CH_GAMBLE(), 16), f64_from(45), "chance: a gamble is worth 45 in expectation");
    assert_eq(ch_opt_action(0, 16), MC_K1(), "chance: the optimal first action is K1");
    ch_set_q(1000);
    assert_eq(ch_oracle_from(0), f64_from(60), "chance: a certain jackpot makes the gamble optimal (60)");
    ch_set_q(0);
    assert_eq(ch_qval(0, CH_GAMBLE(), 16), f64_from(40), "chance: a certain bust: -8 + 48");
    ch_set_q(CH_Q());
    assert_eq(ch_oracle_from(0), f64_from(52), "chance: ch_set_q rebuilds the table");
    return 0;
}

fn test_ch_tree_books(): i64 {
    chance_setup_n(20, 20, 53);
    CH_dn = 0; CH_kn = 0;
    var root = ch_dnode(0, 0); CH_root = root;
    var S = 60; var s = 0;
    while (s < S) { ch_simulate(root, f64_from(1)); s = s + 1; }
    assert_eq(load64(DN_N + root * 8), S, "chance: every simulation visits the root");
    var sum = 0; var kids_ok = 1; var a = 0;
    while (a < g_V) {
        var k = load64(DN_ch + (root * g_V + a) * 8);
        if (k >= 0) {
            sum = sum + load64(KN_N + k * 8);
            var x2 = 0; var nk = 0;
            while (x2 < g_V) {
                var d = load64(KN_kid + (k * g_V + x2) * 8);
                if (d >= 0) {
                    nk = nk + 1;
                    if (load64(DN_tok + d * 8) != x2) { kids_ok = 0; }
                    if ((a != CH_GAMBLE()) && (x2 != a)) { kids_ok = 0; }
                    if ((a == CH_GAMBLE()) && (x2 != CH_JACK()) && (x2 != CH_BUST())) { kids_ok = 0; }
                }
                x2 = x2 + 1;
            }
            if ((a != CH_GAMBLE()) && (nk != 1)) { kids_ok = 0; }
        }
        a = a + 1;
    }
    assert_eq(sum, S - 1, "chance: the root's chance nodes hold every simulation after its expansion");
    assert_eq(kids_ok, 1, "chance: an outcome child holds its outcome; only the gamble has two");
    var c = ch_commit(root); var cn = load64(KN_N + load64(DN_ch + (root * g_V + c) * 8) * 8);
    var most = 1; a = 0;
    while (a < g_V) {
        var k2 = load64(DN_ch + (root * g_V + a) * 8);
        if ((k2 >= 0) && (load64(KN_N + k2 * 8) > cn)) { most = 0; }
        a = a + 1;
    }
    assert_eq(most, 1, "chance: the committed action is the most visited");
    return 0;
}

fn test_ch_exit_records(): i64 {
    chance_setup_n(20, 20, 54);
    var n = ch_exit_collect(16, f64_from(1), 3, 77, 5);
    assert_eq(n, 3 * g_T, "chance: one record per real step");
    var ok = 1; var i = 0;
    while (i < n) {
        var sum = f64_from(0); var a = 0;
        while (a < g_V) {
            var w = load64(XT_p + (i * g_V + a) * 8);
            if (f64_lt(w, f64_from(0)) == 1) { ok = 0; }
            sum = f64_add(sum, w);
            a = a + 1;
        }
        var err = f64_sub(sum, f64_from(1));
        if (f64_lt(err, f64_from(0)) == 1) { err = f64_neg(err); }
        if (f64_gt(err, f64_div(f64_from(1), f64_from(1000000000))) == 1) { ok = 0; }
        i = i + 1;
    }
    assert_eq(ok, 1, "chance: each record is a distribution over actions");
    assert_eq(CH_envseed, 0, "chance: collecting restores the real stream");
    return 0;
}

# ---- --gpu (1.5.0): the device's logits table -------------------------------
# a NaN pattern no forward produces: a declined table must still hold it
fn SENT(): i64 { return 0x7ff8dead00000001; }

# one table on the device against linear_fwd row by row; without a device (or for a
# shape the device does not take) it is declined and left untouched. Returns dev_table's rc.
fn dev_table_case(V, D, seed): i64 {
    pol_init(V, D, 4, 0, seed); g_datalen = 0;
    t_randn(P_b, V, f64_div(f64_from(1), f64_from(10)));          # a nonzero bias
    var Y = t_alloc(V * V); var i = 0;
    while (i < V * V) { store64(Y + i * 8, SENT()); i = i + 1; }
    var f0 = g_dev_fills; var d0 = g_dev_declined;
    g_gpu = 1;
    var rc = dev_table(P_E, P_W, P_b, Y);
    g_gpu = 0;
    if (rc == 0) {
        assert_eq(g_dev_fills, f0 + 1, "dev_table: a fill is counted");
        var ok = 1; var x = 0;
        while (x < V) {
            pol_logits(x);
            if (same_bits(Y + x * V * 8, S_logits, V) == 0) { ok = 0; }
            x = x + 1;
        }
        assert_eq(ok, 1, "dev_table: every row holds linear_fwd's bits (D padded to the k-tile)");
    } else {
        assert_eq(g_dev_declined, d0 + 1, "dev_table: a decline is counted");
        var un = 1; i = 0;
        while (i < V * V) { if (load64(Y + i * 8) != SENT()) { un = 0; } i = i + 1; }
        assert_eq(un, 1, "dev_table: a declined table is left untouched");
    }
    return rc;
}

fn test_dev_table(): i64 {
    # with a device every one of these shapes must run on it; without one each is declined
    var have = 0; if (gpu_probe() == 0) { have = 1; }
    var ran = 0;
    if (dev_table_case(28, 8, 31) == 0) { ran = ran + 1; }      # the demo's shape: D 8 padded to 16
    if (dev_table_case(12, 16, 32) == 0) { ran = ran + 1; }     # D on the k-tile: no padding
    if (dev_table_case(20, 17, 33) == 0) { ran = ran + 1; }     # D 17 padded to 32: two k-tiles
    assert_eq(ran, have * 3, "dev_table: a present device takes every shape tarka pads");
    # with g_gpu off nothing reaches the device, and nothing is counted
    var f0 = g_dev_fills; var d0 = g_dev_declined;
    assert(dev_table(P_E, P_W, P_b, t_alloc(g_V * g_V)) != 0, "dev_table: g_gpu off declines");
    assert_eq(g_dev_fills + g_dev_declined, f0 + d0, "dev_table: g_gpu off counts nothing");
    # V·V past mabda's dispatch cap: declined on every host, device or not
    assert(dev_table_case(256, 8, 34) != 0, "dev_table: a table past the dispatch cap is declined");
    return 0;
}

fn test_dev_memo(): i64 {
    pol_init(10, 8, 6, 2, 41); dpo_init(); rm_init(); g_datalen = 0;
    t_randn(P_b, 10, f64_div(f64_from(1), f64_from(10)));
    dpo_snapshot();
    store64(P_b + 3 * 8, f64_from(1));                  # the policy moves past its reference
    var cpu = t_alloc(300); var x = 0;
    while (x < 10) {
        direct_dist(x, cpu + x * 80);
        ref_logits(x); ref_softmax(); t_copy(cpu + 800 + x * 80, S_refprobs, 10);
        rm_logits(x); t_copy(cpu + 1600 + x * 80, S_rlogits, 10);
        x = x + 1;
    }
    var f0 = g_dev_fills; var d0 = g_dev_declined; var ok = 1;
    memo_begin();                                       # without --gpu: no table is tried
    x = 0;
    while (x < 10) { pol_dist(x); ref_dist(x); rm_reward(x, 0); x = x + 1; }
    memo_end();
    assert_eq(g_dev_fills + g_dev_declined, f0 + d0, "--gpu off: a memo region tries no table");
    g_gpu = 1;
    memo_begin();
    x = 0;
    while (x < 10) {
        pol_dist(x); if (same_bits(S_probs, cpu + x * 80, 10) == 0) { ok = 0; }
        ref_dist(x); if (same_bits(S_refprobs, cpu + 800 + x * 80, 10) == 0) { ok = 0; }
        var a = 0;
        while (a < 10) {
            if (rm_reward(x, a) != load64(cpu + 1600 + (x * 10 + a) * 8)) { ok = 0; }
            a = a + 1;
        }
        x = x + 1;
    }
    memo_end();
    g_gpu = 0;
    assert_eq(ok, 1, "--gpu: pi, pi_ref and r_theta in a memo region are the CPU's bits");
    assert_eq((g_dev_fills - f0) + (g_dev_declined - d0), 3, "--gpu: one table per model and version");
    # declined tables (V·V past the dispatch cap) fall back to the CPU row by row, and each
    # model's is tried once per version
    pol_init(256, 8, 4, 0, 42); dpo_init(); dpo_snapshot(); rm_init(); g_datalen = 0;
    var got = t_alloc(256); var want = t_alloc(256);
    d0 = g_dev_declined; ok = 1;
    g_gpu = 1;
    memo_begin();
    x = 0;
    while (x < 256) {
        pol_dist(x); t_copy(got, S_probs, 256);
        direct_dist(x, want);
        if (same_bits(got, want, 256) == 0) { ok = 0; }
        ref_dist(x); t_copy(got, S_refprobs, 256);
        ref_logits(x); ref_softmax();
        if (same_bits(got, S_refprobs, 256) == 0) { ok = 0; }
        var r = rm_reward(x, 7); rm_logits(x);
        if (r != load64(S_rlogits + 7 * 8)) { ok = 0; }
        x = x + 1;
    }
    memo_end();
    g_gpu = 0;
    assert_eq(ok, 1, "--gpu: a declined table's rows are the CPU's");
    assert_eq(g_dev_declined - d0, 3, "--gpu: a declined table is tried once per model and version");
    return 0;
}

fn main(): i64 {
    alloc_init();
    test_memo_hit_equals_compute();
    test_memo_adam_retires_rows();
    test_memo_external_write_between_regions();
    test_memo_nesting();
    test_memo_reference_and_rm();
    test_parity_reward();
    test_reasoning_answer();
    test_search_helpers();
    test_beam_1x1_is_best_of_1();
    test_gae_normalize();
    test_grpo_equal_group();
    test_buffers_resize();
    test_aggregated_backward();
    test_mc_reward();
    test_mc_oracle();
    test_mc_sort();
    test_mc_tree_books();
    test_dev_table();
    test_dev_memo();
    test_ch_reward();
    test_ch_env();
    test_ch_oracle();
    test_ch_tree_books();
    test_ch_exit_records();
    return assert_summary();
}

var r = main();
sys_exit(r);
