# tarka — preference-ingestion tests (ifran Lane 3, src/pref_ingest.cyr):
# JSONL parse/skip behavior, unescape, sequence shaping, and a mini DPO train
# gate over an ingested pair. Stdlib auto-included via cyrius.cyml.

include "lib/tyche.cyr"
include "lib/rosnet.cyr"
include "lib/akshara.cyr"
include "src/rl.cyr"
include "src/actorcritic.cyr"
include "src/reward.cyr"
include "src/dpo.cyr"
include "src/preference_ext.cyr"
include "src/report.cyr"
include "src/pref_ingest.cyr"

# akshara consumer symbols unused on the pure tokenizer path — stub for a clean build
fn secure_read_file(path, buf, cap): i64 { return 0 - 1; }
fn read_stdin(buf, cap): i64 { return 0 - 1; }
fn file_seek(fd, off): i64 { return 0 - 1; }

fn test_unescape(): i64 {
    var lenp = alloc(8);
    var out = _pi_unescape(str_from("a\\nb\\\"c\\\\d"), lenp);
    assert_eq(load64(lenp), 7, "unescaped length");
    assert_eq(load8(out), 97, "a");
    assert_eq(load8(out + 1), 10, "\\n -> LF");
    assert_eq(load8(out + 2), 98, "b");
    assert_eq(load8(out + 3), 34, "\\\" -> quote");
    assert_eq(load8(out + 4), 99, "c");
    assert_eq(load8(out + 5), 92, "\\\\ -> backslash");
    assert_eq(load8(out + 6), 100, "d");
    return 0;
}

fn test_seq_shape(): i64 {
    var corpus = "abcdef";
    corpus_set(corpus, 6);
    var st = t_alloc(PI_NMAX());
    var ac = t_alloc(PI_NMAX());
    # prompt "ab", completion "cd": states=[b,c] actions=[c,d]
    var n = _pi_seq("ab", 2, "cd", 2, st, ac);
    assert_eq(n, 2, "prompted seq n = completion len");
    assert_eq(load64(st), load64(g_char2id + 98 * 8), "state0 = last prompt token");
    assert_eq(load64(ac), load64(g_char2id + 99 * 8), "action0 = first completion token");
    assert_eq(load64(st + 8), load64(g_char2id + 99 * 8), "state1 = completion[0]");
    assert_eq(load64(ac + 8), load64(g_char2id + 100 * 8), "action1 = completion[1]");
    # prompt-less: bigrams of the completion only (n-1)
    var n2 = _pi_seq("", 0, "abc", 3, st, ac);
    assert_eq(n2, 2, "prompt-less seq n = len-1");
    # empty completion unusable
    assert_eq(_pi_seq("ab", 2, "", 0, st, ac), 0, "empty completion -> 0");
    return 0;
}

fn test_ingest_and_train(): i64 {
    var l1 = "{\"kind\":\"pair\",\"prompt\":\"q\",\"chosen\":\"good answer\",\"rejected\":\"bad reply\"}\n";
    var l2 = "{\"kind\":\"unary\",\"prompt\":\"p\",\"completion\":\"nice one\",\"label\":1}\n";
    var l3 = "{\"kind\":\"unary\",\"prompt\":\"p\",\"completion\":\"awful\",\"label\":-1}\n";
    var l4 = "{\"kind\":\"unary\",\"prompt\":\"p\",\"completion\":\"x\",\"label\":7}\n";       # bad label -> skip
    var l5 = "not json at all\n";                                                            # junk -> skip
    var sb = str_builder_new();
    str_builder_add_cstr(sb, l1);
    str_builder_add_cstr(sb, l2);
    str_builder_add_cstr(sb, l3);
    str_builder_add_cstr(sb, l4);
    str_builder_add_cstr(sb, l5);
    var body = str_builder_build(sb);
    var buf = str_data(body);
    var flen = str_len(body);

    var V = corpus_set(buf, flen);
    pol_init(V, 8, 16, 0, 4242);
    dpo_init();
    dpo_snapshot();
    var total = pref_ingest_file(buf, flen);
    assert_eq(PI_np, 1, "one pair ingested");
    assert_eq(PI_nu, 2, "two unary rows ingested");
    assert_eq(PI_skipped, 2, "bad-label + junk rows skipped");
    assert_eq(total, 3, "total ingested");
    var row = PI_pw;
    assert_eq(_pi_r(row, 2), 11, "pair nW = chosen's 11 bigrams (each side at its own length)");
    assert_eq(_pi_r(row, 5), 9, "pair nL = rejected's 9 bigrams");
    var urow = PI_un + 32;
    assert_eq(load64(urow + 24), 0 - 1, "second unary label -1");

    # mini DPO train over the single ingested pair: Δ goes 0 -> positive
    var d0 = dpo_delta2(_pi_r(row, 0), _pi_r(row, 1), _pi_r(row, 2), _pi_r(row, 3), _pi_r(row, 4), _pi_r(row, 5),
      DPO_BETA());
    assert(f64_lt(f64_abs(d0), f64_div(f64_from(1), f64_from(1000000))) == 1, "theta==ref at start: delta 0");
    _pi_train_pairs(60, f64_div(f64_from(5), f64_from(100)), 0);
    var d1 = dpo_delta2(_pi_r(row, 0), _pi_r(row, 1), _pi_r(row, 2), _pi_r(row, 3), _pi_r(row, 4), _pi_r(row, 5),
      DPO_BETA());
    assert(f64_gt(d1, f64_from(0)) == 1, "after DPO train: chosen ranked above rejected");
    return 0;
}

# ---- 1.2.2 regressions (docs/audit/2026-11-09-audit.md) ---------------------------

# pass 1 + vocab + policy + reference + pass 2, the way tarka_pref_ingest runs them.
# Returns rows ingested (-1 when no row is well-formed).
fn ingest(buf, flen): i64 {
    var text = alloc(flen + 1);
    var tl = pref_corpus(buf, flen, text);
    if (tl < 1) { return 0 - 1; }
    var V = corpus_set(text, tl);
    pol_init(V, 8, 16, 0, 4242); dpo_init(); dpo_snapshot();
    return pref_ingest_file(buf, flen);
}

# ingest one C-string buffer
fn ingest_c(s): i64 { var n = 0; while (load8(s + n) != 0) { n = n + 1; } return ingest(s, n); }

# 1 if every stored token id indexes the policy (0 <= id < g_V)
fn ids_ok(): i64 {
    var k = 0;
    while (k < PI_np) {
        var row = PI_pw + k * PI_PAIRB(); var j = 0;
        while (j < 4) {
            var n = _pi_r(row, 2); var b = _pi_r(row, j); if (j >= 2) { n = _pi_r(row, 5); b = _pi_r(row, j + 1); }
            var t = 0;
            while (t < n) { var id = load64(b + t * 8); if ((id < 0) || (id >= g_V)) { return 0; } t = t + 1; }
            j = j + 1;
        }
        k = k + 1;
    }
    k = 0;
    while (k < PI_nu) {
        var urow = PI_un + k * 32; var un = load64(urow + 16); var j2 = 0;
        while (j2 < 2) {
            var ub = load64(urow + j2 * 8); var u = 0;
            while (u < un) { var uid = load64(ub + u * 8); if ((uid < 0) || (uid >= g_V)) { return 0; } u = u + 1; }
            j2 = j2 + 1;
        }
        k = k + 1;
    }
    return 1;
}

# HIGH: bytes that exist only after decoding (\t, \r, and \n in a file with no raw LF)
# had no token id; id -1 then read P_E - 64 and wrote into P_b. They must tokenize now.
fn test_escaped_bytes_tokenize(): i64 {
    var l = "{\"kind\":\"pair\",\"prompt\":\"Indent this:\\t\",\"chosen\":\"go\\tod\",\"rejected\":\"c\\rd\\nx\"}";
    assert_eq(ingest_c(l), 1, "escaped tab / CR / LF row ingested");
    assert_eq(PI_np, 1, "one pair");
    assert_eq(ids_ok(), 1, "every token id indexes the policy");
    assert_eq(load64(g_char2id + 9 * 8) >= 0, 1, "TAB has an id (vocab over decoded bytes)");
    var row = PI_pw;
    var d0 = dpo_delta2(_pi_r(row, 0), _pi_r(row, 1), _pi_r(row, 2), _pi_r(row, 3), _pi_r(row, 4), _pi_r(row, 5),
      DPO_BETA());
    assert_eq(d0, 0, "theta == ref: delta exactly +0, not NaN");
    var u = "{\"kind\":\"unary\",\"prompt\":\"col1\\t\",\"completion\":\"\\tx\",\"label\":1}";
    assert_eq(ingest_c(u), 1, "escaped tab in a state position ingested");
    assert_eq(ids_ok(), 1, "unary ids in range");
    return 0;
}

# A caller that builds the vocab over the raw file (the 1.2.1 way) gets the row refused
# as "byte not in vocab", never an id of -1 in the tables.
fn test_raw_vocab_refused_not_corrupted(): i64 {
    var l = "{\"kind\":\"pair\",\"prompt\":\"q\",\"chosen\":\"a\\tb\",\"rejected\":\"cd\"}";
    var n = 0; while (load8(l + n) != 0) { n = n + 1; }
    var V = corpus_set(l, n);
    pol_init(V, 8, 16, 0, 4242); dpo_init(); dpo_snapshot();
    assert_eq(pref_ingest_file(l, n), 0, "raw-file vocab: the row is refused");
    assert_eq(pref_skip_count(PI_R_VOCAB()), 1, "reason: byte not in vocab");
    return 0;
}

# decode one JSON string body; returns the buffer (0 = refused), length in *lenp
fn unesc(body, lenp): i64 { return _pi_unescape(str_from(body), lenp); }

fn test_unescape_full(): i64 {
    var lenp = alloc(8);
    var o = unesc("\\b\\f\\/\\u0041", lenp);
    assert_eq(load64(lenp), 4, "\\b \\f \\/ \\u0041: 4 bytes");
    assert_eq(load8(o), 8, "\\b -> 0x08");
    assert_eq(load8(o + 1), 12, "\\f -> 0x0C");
    assert_eq(load8(o + 2), 47, "\\/ -> /");
    assert_eq(load8(o + 3), 65, "\\u0041 -> A");
    o = unesc("\\u00e9\\u20AC", lenp);
    assert_eq(load64(lenp), 5, "U+00E9 + U+20AC: 2 + 3 UTF-8 bytes");
    assert_eq(load8(o), 195, "U+00E9 byte 0 (C3)");
    assert_eq(load8(o + 1), 169, "U+00E9 byte 1 (A9)");
    assert_eq(load8(o + 2), 226, "U+20AC byte 0 (E2)");
    assert_eq(load8(o + 3), 130, "U+20AC byte 1 (82)");
    assert_eq(load8(o + 4), 172, "U+20AC byte 2 (AC)");
    o = unesc("\\ud83d\\ude00", lenp);
    assert_eq(load64(lenp), 4, "surrogate pair -> 4 UTF-8 bytes");
    assert_eq(load8(o), 240, "U+1F600 byte 0 (F0)");
    assert_eq(load8(o + 1), 159, "U+1F600 byte 1 (9F)");
    assert_eq(load8(o + 2), 152, "U+1F600 byte 2 (98)");
    assert_eq(load8(o + 3), 128, "U+1F600 byte 3 (80)");
    assert_eq(unesc("a\\xb", lenp), 0, "unknown escape refused");
    assert_eq(unesc("\\u12", lenp), 0, "short \\u refused");
    assert_eq(unesc("\\u12g4", lenp), 0, "non-hex \\u refused");
    assert_eq(unesc("\\ud83d", lenp), 0, "lone high surrogate refused");
    assert_eq(unesc("\\ud83dx\\ude00", lenp), 0, "high surrogate not followed by \\u refused");
    assert_eq(unesc("\\ude00", lenp), 0, "lone low surrogate refused");
    assert_eq(unesc("ab\\", lenp), 0, "a trailing backslash refused");
    return 0;
}

# a one-line buffer with `label` spliced in (a C-string fragment)
fn label_row(label): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"kind\":\"unary\",\"prompt\":\"p\",\"completion\":\"ok\",\"label\":");
    str_builder_add_cstr(sb, label);
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# 1 if the unary row with this label text is refused for its label
fn label_refused(label): i64 {
    var b = label_row(label);
    var text = alloc(str_len(b) + 1);
    pref_corpus(str_data(b), str_len(b), text);
    if (pref_skip_count(PI_R_LABEL()) == 1) { return 1; }
    return 0;
}

fn test_labels_strict(): i64 {
    assert_eq(label_refused("1"), 0, "label 1 accepted");
    assert_eq(label_refused("-1"), 0, "label -1 accepted");
    assert_eq(label_refused("\"1\""), 1, "label \"1\" (a string) refused");
    assert_eq(label_refused("0.1"), 1, "label 0.1 refused");
    assert_eq(label_refused("+1"), 1, "label +1 refused");
    assert_eq(label_refused("-01"), 1, "label -01 refused");
    assert_eq(label_refused("1e0"), 1, "label 1e0 refused");
    assert_eq(label_refused("true"), 1, "label true refused");
    assert_eq(label_refused("[1]"), 1, "label [1] refused");
    assert_eq(label_refused("18446744073709551617"), 1, "label 2^64+1 refused (str_to_int wraps it to 1)");
    assert_eq(label_refused("x1"), 1, "label x1 refused");
    return 0;
}

# the skip reason pref_corpus gives one line
fn reason_of(l): i64 {
    var n = 0; while (load8(l + n) != 0) { n = n + 1; }
    var text = alloc(n + 1);
    pref_corpus(l, n, text);
    var r = 1;
    while (r <= PI_NREASON()) { if (pref_skip_count(r) == 1) { return r; } r = r + 1; }
    return 0;
}

# the skip reason of the pair line {"kind":"pair","prompt":"q",<mid>} with `pre` before it
# and `post` after it
fn pair_reason(pre, mid, post): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, pre);
    str_builder_add_cstr(sb, "{\"kind\":\"pair\",\"prompt\":\"q\",");
    str_builder_add_cstr(sb, mid);
    str_builder_add_cstr(sb, "}");
    str_builder_add_cstr(sb, post);
    var b = str_builder_build(sb);
    var l = alloc(str_len(b) + 1);
    memcpy(l, str_data(b), str_len(b)); store8(l + str_len(b), 0);
    return reason_of(l);
}

fn test_types_and_structure(): i64 {
    var ok = "\"chosen\":\"a\",\"rejected\":\"b\"";
    assert_eq(reason_of("{\"kind\":pair,\"prompt\":\"q\",\"chosen\":\"a\",\"rejected\":\"b\"}"), PI_R_FIELD(),
      "bare kind -> bad field");
    assert_eq(reason_of("{\"kind\":\"pair\",\"prompt\":12345,\"chosen\":\"a\",\"rejected\":\"b\"}"), PI_R_FIELD(),
      "numeric prompt -> bad field");
    assert_eq(pair_reason("", "\"chosen\":null,\"rejected\":\"b\"", ""), PI_R_FIELD(), "null chosen -> bad field");
    assert_eq(pair_reason("", "\"chosen\":{\"t\":\"a\"},\"rejected\":\"b\"", ""), PI_R_FIELD(),
      "object chosen -> bad field");
    assert_eq(pair_reason("", "\"chosen\":\"a\",\"rejected\":[\"b\"]", ""), PI_R_FIELD(),
      "array rejected -> bad field");
    assert_eq(pair_reason("", "\"chosen\":\"a\"", ""), PI_R_FIELD(), "missing rejected -> bad field");
    assert_eq(pair_reason("junk", ok, ""), PI_R_MALFORMED(), "leading junk -> malformed");
    assert_eq(pair_reason("", ok, "junk"), PI_R_MALFORMED(), "trailing junk -> malformed");
    assert_eq(pair_reason("[", ok, "]"), PI_R_MALFORMED(), "array-wrapped -> malformed");
    assert_eq(pair_reason("", "\"chosen\":\"a\",\"chosen\":\"c\",\"rejected\":\"b\"", ""), PI_R_MALFORMED(),
      "duplicate key -> malformed");
    assert_eq(reason_of("{\"kind\":\"mystery\",\"prompt\":\"q\",\"completion\":\"a\"}"), PI_R_KIND(), "unknown kind");
    assert_eq(pair_reason("", "\"chosen\":\"a\\x\",\"rejected\":\"b\"", ""), PI_R_ESCAPE(),
      "invalid escape -> bad escape");
    assert_eq(pair_reason("  ", ok, "\r"), 0, "surrounding whitespace and CR accepted");
    return 0;
}

fn test_identical_spans(): i64 {
    # chosen and rejected the same text: no preference -> refused
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"kind\":\"pair\",\"prompt\":\"q\",\"chosen\":\"same\",\"rejected\":\"same\"}\n");
    str_builder_add_cstr(sb, "{\"kind\":\"pair\",\"prompt\":\"q\",\"chosen\":\"yes\",\"rejected\":\"nope\"}\n");
    # rejected a prefix of chosen: 1.2.x truncated both to the shared n = 2 and refused it;
    # scored at their own lengths (11 and 2) the sides differ, and the pair trains
    str_builder_add_cstr(sb, "{\"kind\":\"pair\",\"prompt\":\"q\",\"chosen\":\"No. Do not.\",\"rejected\":\"No\"}\n");
    var b = str_builder_build(sb);
    assert_eq(ingest(str_data(b), str_len(b)), 2, "the distinct pair and the prefix pair are ingested");
    assert_eq(pref_skip_count(PI_R_SAME()), 1, "the identical pair is refused");
    var row = PI_pw + PI_PAIRB();
    assert_eq(_pi_r(row, 2), 11, "prefix pair: chosen scored at its own 11 steps");
    assert_eq(_pi_r(row, 5), 2, "prefix pair: rejected at its own 2");
    var acc = alloc(8);
    _pi_train_pairs(60, PI_LR(), 0);
    _pi_dpo_eval(acc);
    assert_eq(load64(acc), 2, "after DPO both pairs rank correctly, the prefix pair included");
    return 0;
}

fn test_row_cap_and_counts(): i64 {
    var sb = str_builder_new();
    var k = 0;
    while (k < PI_MAXEX() + 1) {
        str_builder_add_cstr(sb, "{\"kind\":\"pair\",\"prompt\":\"q\",\"chosen\":\"ab\",\"rejected\":\"cd\"}\n");
        k = k + 1;
    }
    str_builder_add_cstr(sb, "not json\n");
    str_builder_add_cstr(sb, "{\"kind\":\"unary\",\"prompt\":\"p\",\"completion\":\"ok\",\"label\":2}\n");
    var b = str_builder_build(sb);
    assert_eq(ingest(str_data(b), str_len(b)), PI_MAXEX(), "cap: PI_MAXEX pairs ingested");
    assert_eq(pref_skip_count(PI_R_CAP()), 1, "the row past the cap is counted as cap");
    var sum = 0; var r = 1;
    while (r <= PI_NREASON()) { sum = sum + pref_skip_count(r); r = r + 1; }
    assert_eq(sum, PI_skipped, "the reasons sum to PI_skipped");
    assert_eq(PI_skipped, 3, "cap + malformed + bad label");
    return 0;
}

fn test_kto_class_sizes(): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"kind\":\"unary\",\"prompt\":\"p\",\"completion\":\"good one\",\"label\":1}\n");
    str_builder_add_cstr(sb, "{\"kind\":\"unary\",\"prompt\":\"p\",\"completion\":\"fine too\",\"label\":1}\n");
    str_builder_add_cstr(sb, "{\"kind\":\"unary\",\"prompt\":\"p\",\"completion\":\"bad\",\"label\":-1}\n");
    var b = str_builder_build(sb);
    assert_eq(ingest(str_data(b), str_len(b)), 3, "three thumbs");
    var mD = alloc(8); var mU = alloc(8);
    _pi_kto_sep(mD, mU);
    assert_eq(PI_nD, 2, "two desirable");
    assert_eq(PI_nU, 1, "one undesirable");
    return 0;
}

# ---- 1.3.0: --pref options ---------------------------------------------------------
fn test_option_parsers(): i64 {
    assert_eq(pref_parse_uint("300"), 300, "uint 300");
    assert_eq(pref_parse_uint("0"), 0, "uint 0 parses (the caller range-checks)");
    assert_eq(pref_parse_uint(""), 0 - 1, "uint: empty refused");
    assert_eq(pref_parse_uint("12a"), 0 - 1, "uint: a letter refused");
    assert_eq(pref_parse_uint("-5"), 0 - 1, "uint: a sign refused");
    assert_eq(pref_parse_uint("1234567890"), 0 - 1, "uint: 10 digits refused");
    assert_eq(pref_parse_dec("0.05"), PI_LR(), "dec 0.05 has the default's exact bits");
    assert_eq(pref_parse_dec("0.050"), PI_LR(), "dec 0.050 rounds to the same double");
    assert_eq(pref_parse_dec("2"), f64_from(2), "dec 2");
    assert_eq(pref_parse_dec("10"), f64_from(10), "dec 10 (the upper bound)");
    assert_eq(pref_parse_dec("10.5"), 0, "dec past 10 refused");
    assert_eq(pref_parse_dec("0"), 0, "dec 0 refused");
    assert_eq(pref_parse_dec("0.000"), 0, "dec 0.000 refused");
    assert_eq(pref_parse_dec(".5"), 0, "dec without an integer part refused");
    assert_eq(pref_parse_dec("5."), 0, "dec with an empty fraction refused");
    assert_eq(pref_parse_dec("1.2.3"), 0, "dec with two points refused");
    assert_eq(pref_parse_dec("1e-3"), 0, "dec exponent form refused");
    assert_eq(pref_parse_dec("-0.1"), 0, "dec negative refused");
    return 0;
}

fn test_early_stop(): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"kind\":\"pair\",\"prompt\":\"q\",");
    str_builder_add_cstr(sb, "\"chosen\":\"good answer\",\"rejected\":\"bad reply\"}\n");
    str_builder_add_cstr(sb, "{\"kind\":\"pair\",\"prompt\":\"p\",\"chosen\":\"yes\",\"rejected\":\"nope\"}\n");
    var b = str_builder_build(sb);
    assert_eq(ingest(str_data(b), str_len(b)), 2, "two pairs");
    var acc = alloc(8);
    var l0 = _pi_dpo_eval(acc);
    var ran = _pi_fit_pairs(300, PI_LR(), 0, 1, l0);
    var l1 = _pi_dpo_eval(acc);
    assert(ran < 300, "early stop ran fewer than the 300 epochs");
    assert_eq(ran % 10, 0, "early stop runs whole rounds of 10");
    assert_eq(load64(acc), PI_np, "early stop: every pair ranked");
    assert(f64_lt(l1, l0) == 1, "early stop: loss below its start");
    assert_eq(_pi_fit_pairs(7, PI_LR(), 0, 0, l0), 7, "no early stop: all the epochs run");
    assert_eq(_pi_fit_pairs(30, PI_LR(), 0, 1, f64_from(0)), 30,
      "early stop needs the loss below l0 too: an unreachable l0 of 0 runs every epoch");
    return 0;
}

fn main(): i64 {
    alloc_init();
    test_unescape();
    test_seq_shape();
    test_ingest_and_train();
    test_escaped_bytes_tokenize();
    test_raw_vocab_refused_not_corrupted();
    test_unescape_full();
    test_labels_strict();
    test_types_and_structure();
    test_identical_spans();
    test_row_cap_and_counts();
    test_kto_class_sizes();
    test_option_parsers();
    test_early_stop();
    return assert_summary();
}

var exit_code = main();
sys_exit(exit_code);
