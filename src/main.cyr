# tarka — the demo driver: every method in the reference trains or deliberates on a small
# task and must pass its gate (REINFORCE, PPO, GRPO, the parity sample-efficiency
# benchmark, learned PRM/ORM rewards, self-consistency and verifier best-of-N, PRM-guided
# beam search, prior-guided MCTS, MCTS under chance with expert iteration, DPO + the KL
# penalty, IPO + KTO). Exit 0 = ALL GATES PASS. With
# `--pref <file>` it trains DPO / IPO / KTO from an ifran preference export instead
# (src/pref_ingest.cyr). A leading `--gpu` (1.5.0) fills the memo regions' logits tables
# on the device through rosnet's GPU bundle — bit-exact, so every result is the CPU's
# (docs/adr/0004-gpu-parity-backend.md); its own lines start with "GPU: ".
#
#   tarka [--gpu]                     run the demo
#   tarka [--gpu] --pref <file> ...   train from a preference export
#   tarka --help                      usage

include "lib/tyche.cyr"    # rng_seed / rng_uniform / rng_u64 / rng_normal
include "lib/rosnet.cyr"   # linear_fwd / linear_bwd / t_*  (t_randn -> tyche)
include "lib/akshara.cyr"  # corpus_set / gd_ld / g_char2id / g_datalen  (the tokenizer)
include "src/rl.cyr"       # the policy + REINFORCE (rl_prompt draws from the corpus)
include "src/actorcritic.cyr"       # actor-critic: value critic, GAE, PPO, GRPO
include "src/parity.cyr"  # actor-critic sample-efficiency benchmark (parity task)
include "src/reward.cyr"        # reward-model: learned reward & process-reward models (Bradley-Terry)
include "src/dpo.cyr"           # DPO (direct preference optimization) + RLHF KL-to-reference-policy penalty
include "src/preference_ext.cyr"  # IPO (margin-regularized) + KTO (unpaired prospect-theoretic) preference losses
include "src/preference.cyr"  # reward-model transmission demo (learned reward -> RL -> true reward)
include "src/reasoning.cyr"  # verifier-guided reasoning (self-consistency, best-of-N)
include "src/search.cyr"     # PRM-guided tree (beam) search on a sequential task
include "src/mcts.cyr"       # prior-guided MCTS (PUCT) vs beams with the same prior + value
include "src/chance.cyr"     # MCTS with chance nodes vs sampled beams; expert iteration (1.6.0)
include "src/report.cyr"       # print_f2 / print_cd (shared with the --pref driver)
include "src/pref_ingest.cyr"  # ifran pref-export JSONL ingestion (--pref): DPO/IPO/KTO from curated sets

# akshara's emit hook (consumer-supplied) and the demo's string printer
fn _putc(ch): i64 { var b[8]; store8(&b, ch); sys_write(1, &b, 1); return 0; }
# print a NUL-terminated string (the demo's printer)
fn puts(s): i64 { var n = 0; while (load8(s + n) != 0) { n = n + 1; } print(s, n); return 0; }

# akshara's loader/streaming paths (corpus_load_file/stdin, stream_tok) are unused
# by tarka — we drive the pure tokenizer path (corpus_set/gd_ld) only — so these
# consumer symbols stay unreached; stub them so the build is warning-free.
fn secure_read_file(path, buf, cap): i64 { return 0 - 1; }
# akshara consumer hook, unused (see above)
fn read_stdin(buf, cap): i64 { return 0 - 1; }
# akshara consumer hook, unused (see above)
fn file_seek(fd, off): i64 { return 0 - 1; }

# print one MCTS-demo row: the label, the true return, the forwards per prompt
fn mc_row(label, v, f): i64 {
    puts(label); print_f2(v); puts("   (fwd/prompt "); fmt_int(f); puts(")\n");
    return 0;
}

# print one chance-demo row: the label, the real return, the forwards per episode
fn ch_row(label, v, f): i64 {
    puts(label); print_f2(v); puts("   (fwd/episode "); fmt_int(f); puts(")\n");
    return 0;
}

# print the command-line usage
fn usage(): i64 {
    puts("usage: tarka [--gpu]                            run the demo (exit 0 = all gates pass)\n");
    puts("       tarka [--gpu] --pref <file> [options]    train DPO / IPO / KTO from an ifran `pref export`\n");
    puts("                                                JSONL file\n");
    puts("       tarka --help                             this message\n");
    puts("  --gpu          fill the memo's logits tables on the GPU (rosnet's bit-exact class; same results)\n");
    puts("--pref options:\n");
    puts("  --epochs N     epochs per optimizer, 1..100000 (default 300)\n");
    puts("  --lr X         learning rate, a decimal in (0, 10] (default 0.05)\n");
    puts("  --dim D        policy embedding dim, 1..256 (default 8)\n");
    puts("  --early-stop   stop each optimizer once its gate holds (checked every 10 epochs)\n");
    return 0;
}

# a --pref usage error: the message, the usage, exit status 2
fn pref_usage_error(msg, arg): i64 {
    puts("tarka: "); puts(msg); if (arg != 0) { puts(arg); } puts("\n");
    usage();
    return 2;
}

# `tarka --pref <file> [options]`, with --pref at argv(b): parse the options and run the
# ingestion driver
fn pref_main(b): i64 {
    if (argc() < b + 2) { return pref_usage_error("--pref needs a <prefs.jsonl> (an ifran `pref export` file)", 0); }
    var file = argv(b + 1);
    if (load8(file) == 45) { return pref_usage_error("--pref needs the file first, not an option: ", file); }
    var epochs = PI_EPOCHS(); var lr = PI_LR(); var dim = PI_DIM(); var early = 0;
    var i = b + 2;
    while (i < argc()) {
        var a = argv(i);
        var valued = 0;
        if ((streq(a, "--epochs") == 1) || (streq(a, "--lr") == 1) || (streq(a, "--dim") == 1)) { valued = 1; }
        if ((valued == 1) && (i + 1 >= argc())) { return pref_usage_error("missing value for ", a); }
        if (streq(a, "--early-stop") == 1) { early = 1; i = i + 1; }
        elif (streq(a, "--epochs") == 1) {
            epochs = pref_parse_uint(argv(i + 1));
            if ((epochs < 1) || (epochs > 100000)) {
                return pref_usage_error("--epochs must be 1..100000, got ", argv(i + 1));
            }
            i = i + 2;
        } elif (streq(a, "--lr") == 1) {
            lr = pref_parse_dec(argv(i + 1));
            if (lr == 0) { return pref_usage_error("--lr must be a decimal in (0, 10], got ", argv(i + 1)); }
            i = i + 2;
        } elif (streq(a, "--dim") == 1) {
            dim = pref_parse_uint(argv(i + 1));
            if ((dim < 1) || (dim > 256)) { return pref_usage_error("--dim must be 1..256, got ", argv(i + 1)); }
            i = i + 2;
        } else { return pref_usage_error("unknown --pref option: ", a); }
    }
    return tarka_pref_ingest_opts(file, epochs, lr, dim, early);
}

# --gpu: report the device (rosnet's gpu_probe prints its "GPU: " lines)
fn gpu_start(): i64 {
    g_gpu = 1;
    if (gpu_probe() != 0) { puts("GPU: no device: every table is computed on the CPU\n"); }
    return 0;
}

# --gpu: how many logits tables the device filled, and how many it declined
fn gpu_report(): i64 {
    if (g_gpu == 0) { return 0; }
    if (g_dev_fills == 0) {
        puts("GPU: no table ran on the device ("); fmt_int(g_dev_declined);
        puts(" declined, computed on the CPU)\n");
        return 0;
    }
    puts("GPU: "); fmt_int(g_dev_fills); puts(" logits tables filled on the device ("); fmt_int(gpu_mm_count());
    puts(" dispatches), "); fmt_int(g_dev_declined); puts(" declined (computed on the CPU); bit-exact class: ");
    puts("every result above is the CPU's\n");
    return 0;
}

# run the demo, or the --pref driver; returns the exit code
fn main(): i64 {
    alloc_init();
    # --pref <prefs.jsonl>: train DPO/IPO/KTO from an ifran-curated preference
    # export instead of running the demo suite (ifran Lane 3; src/pref_ingest.cyr)
    args_init();
    var b = 1; var gpu = 0;
    if ((argc() >= 2) && (streq(argv(1), "--gpu") == 1)) { gpu = 1; b = 2; }
    if (argc() > b) {
        if ((streq(argv(b), "--help") == 1) || (streq(argv(b), "-h") == 1)) { usage(); return 0; }
        if (streq(argv(b), "--pref") == 1) {
            if (gpu == 1) { gpu_start(); }
            var rc = pref_main(b);
            gpu_report();
            return rc;
        }
        puts("tarka: unknown argument: "); puts(argv(b)); puts("\n");
        usage();
        return 2;
    }
    if (gpu == 1) { gpu_start(); }
    # real tokenized corpus via akshara (byte-level vocab over a short text)
    var corpus = "the quick brown fox jumps over the lazy dog. ";
    var clen = 0; while (load8(corpus + clen) != 0) { clen = clen + 1; }
    var V = corpus_set(corpus, clen);            # byte vocab + packed token store; returns V
    var D = 8; var T = 24;
    var target = load64(g_char2id + 32 * 8);     # reward target = token id of ' ' (space)
    pol_init(V, D, T, target, 1337);
    puts("tarka REINFORCE demo: minimal neural-bigram policy on rosnet + akshara\n");
    puts("  corpus="); fmt_int(clen); puts(" bytes, vocab="); fmt_int(V);
    puts(", D="); fmt_int(D); puts(", T="); fmt_int(T);
    puts(", target=id "); fmt_int(target); puts(" (space)"); _putc(10);

    var r0 = rl_eval(200);
    puts("  reward before (mean target-count out of "); fmt_int(T); puts("): ");
    print_f2(r0); _putc(10);

    rl_train(300, 16, f64_div(f64_from(5), f64_from(100)), 50);   # 300 steps, batch 16, lr 0.05

    var r1 = rl_eval(200);
    puts("  reward after:  "); print_f2(r1); _putc(10);

    # ---- actor-critic: PPO + GRPO learn the same task ----
    puts("\n--- actor-critic: PPO + group-relative GRPO (same corpus task) ---\n");
    pol_init(V, D, T, target, 2024); ac_init();
    var p0 = rl_eval(200);
    ppo_train(250, 4, f64_div(f64_from(5), f64_from(100)), 0);   # 250 steps × 4 epochs, lr 0.05
    var p1 = rl_eval(200);
    puts("  PPO  (critic+GAE, clip 0.2, 4 epochs): "); print_f2(p0); puts(" -> "); print_f2(p1); _putc(10);

    pol_init(V, D, T, target, 2024); ac_init();
    var q0 = rl_eval(200);
    grpo_train(250, 8, f64_div(f64_from(5), f64_from(100)), 0);  # 250 steps, group 8, lr 0.05
    var q1 = rl_eval(200);
    puts("  GRPO (group 8, no critic, clip 0.2):   "); print_f2(q0); puts(" -> "); print_f2(q1); _putc(10);

    var learn_ok = 1;
    if (f64_gt(r1, f64_mul(r0, f64_from(2))) == 0) { learn_ok = 0; }
    if (f64_gt(p1, f64_mul(p0, f64_from(2))) == 0) { learn_ok = 0; }
    if (f64_gt(q1, f64_mul(q0, f64_from(2))) == 0) { learn_ok = 0; }
    if (learn_ok == 1) { puts("  (all three learn the count task)\n"); }

    # ---- actor-critic acceptance: sample-efficiency on the parity task ----
    puts("\n--- actor-critic acceptance: rollouts-to-threshold on the parity task (median of 5 seeds) ---\n");
    var lr = f64_div(f64_from(5), f64_from(100));         # 0.05
    var rfRoll = bench_median(0, 8, lr);                  # REINFORCE, batch 8
    var ppRoll = bench_median(1, 4, lr);                  # PPO, 4 epochs
    var grRoll = bench_median(2, 8, lr);                  # GRPO, group 8
    puts("  REINFORCE: "); fmt_int(rfRoll); puts(" rollouts to reach mean reward ");
    print_f2(BENCH_THRESH()); _putc(10);
    puts("  PPO:       "); fmt_int(ppRoll); puts(" rollouts"); _putc(10);
    puts("  GRPO:      "); fmt_int(grRoll); puts(" rollouts"); _putc(10);

    var ac_ok = 0;
    if ((learn_ok == 1) && (ppRoll < rfRoll) && (grRoll < rfRoll)) {
        ac_ok = 1; puts("\n  actor-critic GATE PASS: PPO and GRPO are more sample-efficient than REINFORCE\n");
    } else { puts("\n  actor-critic GATE FAIL\n"); }

    # ---- reward-model: learned reward models — process (PRM) vs outcome (ORM) supervision ----
    # Each reward model is trained ONLY from preference orderings (never the true reward);
    # then a FRESH policy is RL-trained on the FROZEN learned reward and we measure its
    # TRUE reward. PRM gives a DENSE per-step reward (process supervision); ORM gives a
    # SPARSE terminal reward (outcome). Same RL budget — process supervision should reach
    # higher true reward (Lightman 2023).
    puts("\n--- reward-model: learned reward models (Bradley-Terry; reward model never sees the true reward) ---\n");
    var rmlr = f64_div(f64_from(5), f64_from(100));
    var transmit = f64_from(5);                                      # transmission floor (≈4x random 1.33)

    # ORM (outcome): rollout-level preferences -> sparse terminal RL reward
    pol_init(BENCH_V(), BENCH_D(), BENCH_T(), BENCH_TGT(), 31337); ac_init(); rm_init();
    g_decoy = BENCH_DECOY(); g_datalen = 0;
    rm_train_orm(400, 16, rmlr);
    var oacc = rm_orm_accuracy(300);
    pol_init(BENCH_V(), BENCH_D(), BENCH_T(), BENCH_TGT(), 999); ac_init();
    g_decoy = BENCH_DECOY(); g_datalen = 0;
    var ost = 0; while (ost < 25) { rm_orm_grpo_step(8, rmlr); ost = ost + 1; }   # GRPO, ~200 rollouts
    var orm_true = par_eval(200);
    puts("  ORM (outcome -> GRPO, group-normalized): held-out acc "); fmt_int(oacc); puts("%, policy TRUE reward ");
    print_f2(orm_true); puts(" / "); fmt_int(BENCH_T()); _putc(10);

    # PRM (process): step-level preferences -> dense per-step RL reward
    pol_init(BENCH_V(), BENCH_D(), BENCH_T(), BENCH_TGT(), 31337); ac_init(); rm_init();
    g_decoy = BENCH_DECOY(); g_datalen = 0;
    rm_train_prm(400, 16, rmlr);
    var pacc = rm_prm_accuracy(500) / 5;                             # -> percent
    pol_init(BENCH_V(), BENCH_D(), BENCH_T(), BENCH_TGT(), 999); ac_init();
    g_decoy = BENCH_DECOY(); g_datalen = 0;
    var pst = 0; while (pst < 200) { rm_ppo_step(4, rmlr); pst = pst + 1; }
    var prm_true = par_eval(200);
    puts("  PRM (process, dense per-step):  held-out acc "); fmt_int(pacc); puts("%, policy TRUE reward ");
    print_f2(prm_true); puts(" / "); fmt_int(BENCH_T()); _putc(10);

    # reward-model gate: both learned rewards TRANSMIT (acc>80% + policy true reward > floor); and
    # process supervision (PRM) reaches at least the outcome (ORM) true reward at equal budget.
    var reward_ok = 0;
    if ((oacc > 80) && (pacc > 80) && (f64_gt(orm_true, transmit) == 1) && (f64_gt(prm_true, transmit) == 1)
        && (f64_lt(orm_true, prm_true) == 1)) {
        reward_ok = 1;
        puts("  reward-model GATE PASS: both learned rewards transmit; ");
        puts("PRM (process) >= ORM (outcome) at equal budget\n");
    } else { puts("  reward-model GATE FAIL\n"); }

    # ---- reasoning: verifier-guided reasoning — deliberation at inference beats single-sample ----
    puts("\n--- reasoning: verifier-guided reasoning (deliberation at inference, no extra training) ---\n");
    reason_setup();                                                  # partial (imperfect) policy + frozen PRM verifier
    var corr = reason_verifier_gate(400);
    var m4single = reason_accuracy(0, 1, 400, 2000);
    var sc16 = reason_accuracy(1, 16, 400, 2000);
    var sc64 = reason_accuracy(1, 64, 400, 2000);
    puts("  self-consistency (answer acc /1000, random 500): single="); fmt_int(m4single);
    puts(" -> vote@16="); fmt_int(sc16); puts(" -> vote@64="); fmt_int(sc64); _putc(10);
    var bmean = reason_best_of_n(0, 16, 400, 2000);
    var bver  = reason_best_of_n(1, 16, 400, 2000);
    var borac = reason_best_of_n(2, 16, 400, 2000);
    puts("  best-of-16 true reward (x100/16): mean-sample="); fmt_int(bmean);
    puts("  PRM-verifier-selected="); fmt_int(bver); puts("  oracle="); fmt_int(borac); _putc(10);

    # reasoning gate: the PRM verifier is useful (corr); self-consistency scales decisively above
    # single-sample; and verifier best-of-N reranks far above the mean sample, ~matching the oracle.
    var reason_ok = 0;
    if ((corr == 1) && (sc64 > m4single + 100) && (sc16 > m4single) && (bver > bmean + 100)) {
        reason_ok = 1;
        puts("  reasoning GATE PASS: deliberation beats single-sample (SC scales; verifier best-of-N ~ oracle)\n");
    } else { puts("  reasoning GATE FAIL\n"); }

    # ---- search: PRM-guided beam search generates what greedy/best-of-N cannot ----
    # Task: emit a TARGET token the policy never favors (greedy ~0) — verifier-guided beam STEERS
    # each step toward it via pruning; best-of-N can only filter whole samples. Metric = #TARGET / 16.
    puts("\n--- reasoning (search): PRM-guided beam search on a sequential task ---\n");
    search_setup(); search_init();
    g_fwd = 0; var s_greedy = srch_greedy(200, 2000); var fwd_g = g_fwd / 200;
    g_fwd = 0; var s_bon = srch_best_of_n(36, 200, 2000); var fwd_b = g_fwd / 200;   # N=36 ~ matched to beam
    g_fwd = 0; var s_beam = srch_beam(8, 8, 200, 2000); var fwd_m = g_fwd / 200;
    puts("  greedy decode:       "); print_cd(s_greedy); puts(" / 16   (fwd/prompt "); fmt_int(fwd_g); puts(")\n");
    puts("  best-of-N (sample):  "); print_cd(s_bon); puts(" / 16   (fwd/prompt "); fmt_int(fwd_b); puts(")\n");
    puts("  PRM-guided beam:     "); print_cd(s_beam); puts(" / 16   (fwd/prompt "); fmt_int(fwd_m); puts(")\n");

    # search gate: verifier-guided beam beats best-of-N >= 2x (steering > sampling) at <= its compute,
    # and best-of-N beats greedy (the policy never favors TARGET).
    var search_ok = 0;
    if ((s_beam > 2 * s_bon) && (s_bon > s_greedy) && (fwd_m <= fwd_b)) {
        search_ok = 1;
        puts("  search GATE PASS: PRM-guided beam >> best-of-N >> greedy at matched-or-lower compute\n");
    } else { puts("  search GATE FAIL\n"); }

    # ---- reasoning (MCTS): prior-guided tree search where a step's worth shows later ----
    # The corridor (src/mcts.cyr): K1 K2 K3 open GOAL (+4/step), TRAP pays +1/step, out-of-order
    # entries cost 60. The evaluator is the exact reward; the prior is behavior-cloned from
    # noisy demonstrations, the value is its critic. Every method uses the same networks.
    puts("\n--- reasoning (MCTS): prior-guided tree search on a delayed-payoff task ---\n");
    mcts_setup();
    var mnp = 40; var mseed = 2000;
    var m_or = mc_oracle(mnp, mseed);
    g_fwd = 0; var m_gr = mc_pgreedy(mnp, mseed); var f_gr = g_fwd / mnp;
    g_fwd = 0; var m_bon = mc_best_of_n(64, mnp, mseed); var f_bon = g_fwd / mnp;
    g_fwd = 0; var m_bm = mc_beam(16, 1, 0, mnp, mseed); var f_bm = g_fwd / mnp;
    g_fwd = 0; var m_bp = mc_beam(16, 4, 2, mnp, mseed); var f_bp = g_fwd / mnp;
    g_fwd = 0; var m_mc = mc_mcts(512, f64_from(1), mnp, mseed); var f_mc = g_fwd / mnp;
    g_fwd = 0; var m_bpv = mc_beam(4, 4, 3, mnp, mseed); var f_bpv = g_fwd / mnp;
    puts("  true return, mean of "); fmt_int(mnp); puts(" prompts (optimum "); print_f2(m_or);
    puts(", TRAP path 16.00):\n");
    mc_row("  policy greedy:                     ", m_gr, f_gr);
    mc_row("  best-of-64:                        ", m_bon, f_bon);
    mc_row("  beam, myopic (B 16):               ", m_bm, f_bm);
    mc_row("  beam, prior (B 16, K 4):           ", m_bp, f_bp);
    mc_row("  MCTS, PUCT prior + value (S 512):  ", m_mc, f_mc);
    mc_row("  beam, prior + value (B 4, K 4):    ", m_bpv, f_bpv);

    # mcts gate: MCTS reaches 85% of the optimum and beats greedy, best-of-N and the two beams
    # without lookahead at matched-or-higher compute for them — and (the honest half) a beam
    # given the same prior + value also reaches 85%, at no more than MCTS's compute.
    var m_floor = f64_mul(m_or, f64_div(f64_from(85), f64_from(100)));
    var mcts_ok = 0;
    if ((f64_gt(m_mc, m_floor) == 1) && (f64_gt(m_mc, m_gr) == 1)
        && (f64_gt(m_mc, m_bon) == 1) && (f_bon >= f_mc)
        && (f64_gt(m_mc, m_bm) == 1) && (f_bm >= f_mc)
        && (f64_gt(m_mc, m_bp) == 1) && (f_bp >= f_mc)
        && (f64_gt(m_bpv, m_floor) == 1) && (f_bpv <= f_mc)) {
        mcts_ok = 1;
        puts("  mcts GATE PASS: the learned value's lookahead solves it — MCTS beats greedy, best-of-N and the\n");
        puts("    myopic beams at matched compute; a beam with the same prior + value matches it at less compute\n");
    } else { puts("  mcts GATE FAIL\n"); }

    # ---- reasoning (MCTS under chance): a random outcome the beam over-trusts ----
    # The casino corridor (src/chance.cyr): the corridor plus GAMBLE, a shortcut that pays off
    # with probability 1/4 and otherwise costs 8 — a loss in expectation. The planners get a
    # sampler only; every method acts closed-loop on the same real outcomes.
    puts("\n--- reasoning (MCTS under chance): a gamble a sampled beam over-trusts ---\n");
    chance_setup();
    var cnp = 40; var cseed = 2000; var c1 = f64_from(1);
    var c_or = ch_oracle(cnp, cseed);
    g_fwd = 0; var c_gr = ch_greedy(cnp, cseed); var fc_gr = g_fwd / cnp;
    g_fwd = 0; var c_bon = ch_best_of_n(64, cnp, cseed); var fc_bon = g_fwd / cnp;
    g_fwd = 0; var c_bm = ch_beam(16, 4, 1, cnp, cseed); var fc_bm = g_fwd / cnp;
    g_fwd = 0; var c_b4 = ch_beam(16, 4, 4, cnp, cseed); var fc_b4 = g_fwd / cnp;
    g_fwd = 0; var c_mc = ch_mcts(128, c1, cnp, cseed); var fc_mc = g_fwd / cnp;
    ch_set_q(0);                                 # the same networks; the gamble always busts
    g_fwd = 0; var c_b0 = ch_beam(16, 4, 1, cnp, cseed); var fc_b0 = g_fwd / cnp;
    ch_set_q(CH_Q());
    puts("  real return, mean of "); fmt_int(cnp); puts(" episodes (optimum in expectation ");
    print_f2(c_or); puts("):\n");
    ch_row("  policy greedy:                       ", c_gr, fc_gr);
    ch_row("  best-of-64:                          ", c_bon, fc_bon);
    ch_row("  beam (B 16, K 4):                    ", c_bm, fc_bm);
    ch_row("  beam, 4 outcome samples (B 16, K 4): ", c_b4, fc_b4);
    ch_row("  MCTS, chance nodes (S 128):          ", c_mc, fc_mc);
    puts("  the same networks, the gamble made certain to bust:\n");
    ch_row("  beam (B 16, K 4):                    ", c_b0, fc_b0);
    # expert iteration: MCTS's visit counts on 32 episodes of its own, distilled into π
    ch_exit_collect(128, c1, 32, 9000, 1);
    ch_exit_train(200, f64_div(f64_from(5), f64_from(100)));
    g_fwd = 0; var x_gr = ch_greedy(cnp, cseed); var fx_gr = g_fwd / cnp;
    g_fwd = 0; var x_bm = ch_beam(16, 4, 1, cnp, cseed); var fx_bm = g_fwd / cnp;
    g_fwd = 0; var x_mc = ch_mcts(64, c1, cnp, cseed); var fx_mc = g_fwd / cnp;
    puts("  expert iteration (π trained on MCTS's visit counts):\n");
    ch_row("  policy greedy:                       ", x_gr, fx_gr);
    ch_row("  beam (B 16, K 4):                    ", x_bm, fx_bm);
    ch_row("  MCTS, chance nodes (S 64):           ", x_mc, fx_mc);

    # chance gate, three claims:
    #   - MCTS reaches 90% of the optimum and beats the beam, and best-of-N and the averaged
    #     beam at matched-or-higher compute for them;
    #   - the cause is chance: the beam is under 90% here, and over it with the gamble made
    #     certain (the same networks);
    #   - expert iteration: the distilled π decodes greedily 10 points above the cloned one,
    #     and as MCTS's prior does at least as well at no more compute.
    var c_floor = f64_mul(c_or, f64_div(f64_from(90), f64_from(100)));
    var chance_ok = 0;
    if ((f64_gt(c_mc, c_floor) == 1)
        && (f64_gt(c_mc, c_bon) == 1) && (fc_bon >= fc_mc)
        && (f64_gt(c_mc, c_b4) == 1) && (fc_b4 >= fc_mc)
        && (f64_gt(c_mc, c_bm) == 1)
        && (f64_lt(c_bm, c_floor) == 1) && (f64_gt(c_b0, c_floor) == 1)
        && (f64_gt(x_gr, f64_add(c_gr, f64_from(10))) == 1)
        && (f64_lt(x_mc, c_mc) == 0) && (fx_mc <= fc_mc)) {
        chance_ok = 1;
        puts("  chance GATE PASS: averaging over outcomes, MCTS avoids the gamble a sampled beam keeps; the\n");
        puts("    beam recovers when the gamble is certain; distilling MCTS fixes greedy decoding (and the beam)\n");
    } else { puts("  chance GATE FAIL\n"); }

    # ---- alignment: DPO (preferences only) + RLHF KL-to-reference-policy penalty ----
    # DPO aligns the policy from PREFERENCES ALONE — no reward model, no value critic, no
    # sampler-in-the-loop reward: each step prefers the higher-target-count rollout while the
    # FROZEN reference KL-anchors the policy (Rafailov 2023). The KL-to-reference penalty
    # (Ouyang 2022) then explicitly pulls a diverged policy back toward that reference.
    puts("\n--- alignment: DPO (preferences only, frozen reference) + RLHF KL-to-reference penalty ---\n");
    pol_init(V, D, T, target, 4242); dpo_init();
    dpo_snapshot();                                       # reference policy = initial policy
    var a0 = rl_eval(200);
    dpo_train(300, 16, f64_div(f64_from(5), f64_from(100)));   # 300 steps, batch 16, lr 0.05
    var a1 = rl_eval(200);
    var kl_b = dpo_mean_kl(64);                           # how far DPO moved the policy from the reference
    puts("  DPO (preferences only): target freq "); print_f2(a0); puts(" -> "); print_f2(a1);
    puts("  (mean KL to reference "); print_f2(kl_b); puts(")"); _putc(10);

    # KL-to-reference penalty: gradient-descend β·KL(π_θ‖π_ref) to pull the policy back.
    var kstep = 0;
    while (kstep < 60) { kl_penalty_step(DPO_BETA(), f64_div(f64_from(5), f64_from(100))); kstep = kstep + 1; }
    var kl_a = dpo_mean_kl(64);
    puts("  KL-to-reference penalty: mean KL "); print_f2(kl_b); puts(" -> "); print_f2(kl_a);
    puts("  (policy pulled back toward reference)"); _putc(10);

    # alignment gate: DPO raises target frequency from preferences alone (>= 1.5x), and the
    # KL penalty measurably reduces divergence from the reference.
    var align_ok = 0;
    if ((f64_gt(a1, f64_mul(a0, f64_div(f64_from(3), f64_from(2)))) == 1) && (f64_lt(kl_a, kl_b) == 1)) {
        align_ok = 1;
        puts("  alignment GATE PASS: DPO aligns from preferences; KL penalty pulls policy to reference\n");
    } else { puts("  alignment GATE FAIL\n"); }

    # ---- alignment (cont.): IPO (margin-regularized) + KTO (unpaired prospect-theoretic) ----
    # Two more preference optimizers on the SAME frozen-reference machinery. IPO regresses the
    # implicit-reward margin h toward a FINITE target 1/(2β) (pulling back if it overshoots —
    # DPO never stops pushing). KTO needs no pairs: each rollout is labeled desirable/undesirable
    # on its own against a detached KL reference point. Both are FD-grad-checked (tests/tarka.tcyr).
    puts("\n--- alignment: IPO (margin-regularized preferences) + KTO (unpaired prospect-theoretic) ---\n");
    pol_init(V, D, T, target, 4242); dpo_init(); dpo_snapshot();
    var ih0 = ipo_mean_h(100);
    ipo_train(300, 16, f64_div(f64_from(5), f64_from(100)));   # 300 steps, batch 16, lr 0.05
    var ih1 = ipo_mean_h(100);
    var itgt = ipo_target(IPO_BETA());
    puts("  IPO: mean implicit-reward margin h "); print_f2(ih0); puts(" -> "); print_f2(ih1);
    puts("  (regressing toward target margin "); print_f2(itgt); puts(")"); _putc(10);

    # two FIXED held sequences read the effect honestly (post-training sampling no longer
    # produces target-free rollouts, so a sampled split would be degenerate): a desirable
    # one (all target token) and an undesirable one (all a non-target token).
    var ED_st = t_alloc(T); var ED_ac = t_alloc(T);
    var EU_st = t_alloc(T); var EU_ac = t_alloc(T);
    var nt = 0; if (target == 0) { nt = 1; }                   # a token id != target
    var et = 0;
    while (et < T) {
        store64(ED_st + et*8, target); store64(ED_ac + et*8, target);
        store64(EU_st + et*8, nt);     store64(EU_ac + et*8, nt);
        et = et + 1;
    }
    pol_init(V, D, T, target, 4242); dpo_init(); dpo_snapshot();
    var kd0 = kto_logratio(ED_st, ED_ac, T); var ku0 = kto_logratio(EU_st, EU_ac, T);   # ρ at the reference = 0
    kto_train(300, 16, f64_div(f64_from(5), f64_from(100)));   # 300 steps, batch 16, lr 0.05
    var kd1 = kto_logratio(ED_st, ED_ac, T); var ku1 = kto_logratio(EU_st, EU_ac, T);
    puts("  KTO: desirable ρ "); print_f2(kd0); puts(" -> "); print_f2(kd1);
    puts(" ; undesirable ρ "); print_f2(ku0); puts(" -> "); print_f2(ku1); _putc(10);
    var ext_ok = 0;
    if ((f64_gt(ih1, ih0) == 1) && (f64_gt(kd1, kd0) == 1) && (f64_lt(ku1, ku0) == 1)) {
        ext_ok = 1;
        puts("  preference-ext: IPO raises h toward its target margin; ");
        puts("KTO raises desirable ρ + lowers undesirable ρ\n");
    } else { puts("  preference-ext GATE FAIL\n"); }

    gpu_report();
    if ((ac_ok == 1) && (reward_ok == 1) && (reason_ok == 1) && (search_ok == 1) && (mcts_ok == 1) && (chance_ok == 1)
        && (align_ok == 1) && (ext_ok == 1)) {
        puts("\n  ALL GATES PASS\n"); return 0;
    }
    puts("\n  GATE FAIL\n");
    return 1;
}

var r = 0;
r = main();
sys_exit(r);
