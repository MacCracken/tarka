# tarka — minimal REINFORCE on a rosnet-backed policy (REINFORCE).
#
# A deliberately minimal autoregressive softmax policy: token embedding E(V×D) +
# linear head W(D×V), b(V), so  pi(next | cur) = softmax(E[cur] @ W + b)  — a
# "neural bigram". It is trained by on-policy REINFORCE (Williams 1992): sample
# rollouts from the policy, score each with a deterministic reward (count of a
# target token), and weight the softmax cross-entropy gradient by the advantage
# (R - baseline). The key identity (the same one attn11's --objective rl used):
# for a softmax head  grad log pi(a) = -grad CE(a), so the policy gradient IS the
# softmax-CE backward over the sampled rollout scaled by the advantage — no new
# backward math. Here that backward runs on rosnet's linear_fwd / linear_bwd
# (matmul + its gradient); tyche supplies rollout sampling + init. No transformer:
# the RL loop is the point, the policy is the smallest thing that carries it.
#
# Depends on: lib/rosnet.cyr (linear_fwd/linear_bwd, t_*), lib/tyche.cyr (rng_*), and for
# --gpu lib/rosnet-gpu.cyr (g_gpu, gpu_matmul_fwd, GPU_TK).

# ---- dims / reward (set by pol_init's caller) ------------------------------
var g_V = 0;        # vocab size
var g_D = 0;        # embedding dim
var g_T = 0;        # rollout length (sampled actions per rollout)
var g_target = 0;   # reward target token id

# ---- hardening: fail-loud precondition guard (0.8.0 audit) ------------------
var _guard_buf[64];     # module scope: 64 i64 slots = 512 bytes for guard's composed message

# Cyrius has no bounds checks: an out-of-range store64 silently corrupts the heap.
# Public entries that index fixed-size buffers (beam width vs BMAX, GRPO group vs
# GMAX) call guard() to turn a silent overrun into a clear abort. A no-op when the
# precondition holds (every current call site satisfies them), so demo/tests are
# byte-identical. Since 1.3.0 it aborts through the stdlib's panic, which writes
# "panic: tarka: precondition violated: <msg>" to stderr and exits 1. The message is
# composed in a static buffer, not the heap: a guard may fire before alloc_init, and it
# must not depend on the state it protects.
fn guard(cond, msg): i64 {
    if (cond == 0) {
        var pre = "tarka: precondition violated: ";
        var o = 0; var i = 0;
        while (load8(pre + i) != 0) { store8(&_guard_buf + o, load8(pre + i)); o = o + 1; i = i + 1; }
        i = 0;
        while ((load8(msg + i) != 0) && (o < 511)) { store8(&_guard_buf + o, load8(msg + i)); o = o + 1; i = i + 1; }
        store8(&_guard_buf + o, 0);
        panic(&_guard_buf);
    }
    return 0;
}

# ---- parameters (rosnet f64 tensors; t_alloc = n*8 bytes, f64 per slot) -----
var P_E = 0;        # embedding   V*D
var P_W = 0;        # head weight D*V
var P_b = 0;        # head bias   V
var G_E = 0; var G_W = 0; var G_b = 0;                 # gradients (accumulate)
var M_E = 0; var V_E = 0;                              # adam moments
var M_W = 0; var V_W = 0;
var M_b = 0; var V_b = 0;

# ---- scratch ----------------------------------------------------------------
var S_logits = 0;   # V   forward logits for one position
var S_probs = 0;    # V   softmax(S_logits)
var S_demb = 0;     # D   d_emb (dx out of linear_bwd) for one position
var R_states = 0;   # T   rollout states (token ids)
var R_actions = 0;  # T   rollout sampled actions (token ids)

# ---- memo regions: a per-state distribution cache ---------------------------
# (docs/architecture/001-distribution-memo.md). The policy is a bigram: pi(.|x) depends
# only on the state token x and the parameters, and inside one training step or one
# evaluation loop the parameters do not change. So tarka's own train / eval loops run
# inside a memo region (memo_begin .. memo_end), where pol_dist computes pi(.|x) once per
# state and then copies it. Outside a region pol_dist IS pol_logits + pol_softmax, so a
# caller that writes P_* directly (the finite-difference grad-checks do) is unaffected.
# Every parameter write inside a region goes through pol_adam_step or pol_init, and both
# bump PM_epoch; entering the outermost region starts a new generation, which retires
# every row filled before it. Same inputs, same kernel: the bits are identical either way
# (tests/golden.tcyr). The frozen reference (src/dpo.cyr) and the reward model
# (src/reward.cyr) keep their own caches on the same rules.
var g_memo_depth = 0;   # > 0 inside a memo region
var g_memo_gen = 0;     # bumped on entering the outermost region
var PM_probs = 0;       # V*V  cached pi(.|x), row x
var PM_stamp = 0;       # V    the PM_epoch row x was filled at (0 = never)
var PM_epoch = 0;       # the policy's parameter version
var PM_seen = 0;        # the g_memo_gen PM_epoch was last synced to

# enter a memo region (nests; the outermost entry starts a new generation)
fn memo_begin(): i64 {
    if (g_memo_depth == 0) { g_memo_gen = g_memo_gen + 1; }
    g_memo_depth = g_memo_depth + 1;
    return 0;
}

# leave a memo region
fn memo_end(): i64 {
    g_memo_depth = g_memo_depth - 1;
    # every training loop applies its deferred gradients (pol_scale_grads / pol_adam_step)
    # before its region closes; a pending row left here would be a gradient silently lost
    if (g_memo_depth == 0) { guard(PB_n == 0, "memo_end: a deferred policy gradient was never applied"); }
    return 0;
}

# ---- the device path: `tarka --gpu` (1.5.0; docs/adr/0004-gpu-parity-backend.md) ----
# A memo miss under rosnet's g_gpu fills the whole logits table at once, every state x in
# one Y(V×V) = E(V×D)·W(D×V) + b, through gpu_matmul_fwd — rosnet's bit-exact class: row x
# holds the bits linear_fwd gives for state x. The device's k-tile is GPU_TK, so D is
# zero-padded to a multiple of it; each padded term adds (+0)·(+0), which leaves a sum
# unchanged unless the sum is −0, and these sums start from a bias tarka never makes −0
# (t_zero writes +0; an exact cancellation rounds to +0). tests/golden.tcyr re-runs every
# case under g_gpu and requires the same digests. A table the device declines (no device,
# a shape it does not take, a failed dispatch: rosnet leaves Y untouched) is computed row
# by row on the CPU, as without --gpu. With g_gpu = 0 none of this runs.
var DV_V = 0; var DV_D = 0; var DV_K = 0;   # the dims the staging buffers were sized for
var DV_x = 0;           # V × K  the embedding, zero-padded to the k-tile
var DV_w = 0;           # K × V  the head weight, zero-padded
var g_dev_fills = 0;    # tables the device filled
var g_dev_declined = 0; # tables it declined (their rows were computed on the CPU)
var PM_lg = 0;          # V*V   the policy's logits table from the device
var PM_lgV = 0;         # the V PM_lg was sized for
var PM_lgtry = 0;       # the PM_epoch a fill was last tried at
var PM_lgok = 0;        # 1 = that try filled PM_lg

# Y(V×V) = E·W + b for every state at once on the device: 0 = filled, non-0 = declined
fn dev_table(E, W, b, Y): i64 {
    if (g_gpu == 0) { return 1; }
    if ((DV_V != g_V) || (DV_D != g_D)) {
        var tk = GPU_TK();
        DV_K = ((g_D + tk - 1) / tk) * tk;
        DV_x = t_alloc(g_V * DV_K); DV_w = t_alloc(DV_K * g_V);
        t_zero(DV_x, g_V * DV_K); t_zero(DV_w, DV_K * g_V);
        DV_V = g_V; DV_D = g_D;
    }
    var x = 0;
    while (x < g_V) { t_copy(DV_x + x * DV_K * 8, E + x * g_D * 8, g_D); x = x + 1; }
    t_copy(DV_w, W, g_D * g_V);              # rows D..K-1 stay zero
    if (gpu_matmul_fwd(DV_x, DV_w, b, Y, g_V, DV_K, g_V) != 0) {
        g_dev_declined = g_dev_declined + 1;
        return 1;
    }
    g_dev_fills = g_dev_fills + 1;
    return 0;
}

# S_logits for state x on a memo miss: the device's table when --gpu filled it at this
# parameter version, else linear_fwd on the CPU
fn pol_miss_logits(x): i64 {
    if (g_gpu == 1) {
        if (PM_lgV != g_V) { PM_lg = t_alloc(g_V * g_V); PM_lgV = g_V; PM_lgtry = 0; }
        if (PM_lgtry != PM_epoch) {
            PM_lgtry = PM_epoch;
            PM_lgok = 0;
            if (dev_table(P_E, P_W, P_b, PM_lg) == 0) { PM_lgok = 1; }
        }
        if (PM_lgok == 1) { t_copy(S_logits, PM_lg + x * g_V * 8, g_V); return 0; }
    }
    return pol_logits(x);
}

# S_probs = pi(.|x): computed, or inside a memo region copied from the cache when the
# row was filled at the current parameter version.
fn pol_dist(x): i64 {
    if (g_memo_depth == 0) { pol_logits(x); pol_softmax(); return 0; }
    guard((x >= 0) && (x < g_V), "pol_dist: state token out of range (0..V-1)");
    if (PM_seen != g_memo_gen) { PM_epoch = PM_epoch + 1; PM_seen = g_memo_gen; }
    var row = PM_probs + x * g_V * 8;
    if (load64(PM_stamp + x * 8) == PM_epoch) { t_copy(S_probs, row, g_V); return 0; }
    pol_miss_logits(x); pol_softmax();
    t_copy(row, S_probs, g_V);
    store64(PM_stamp + x * 8, PM_epoch);
    return 0;
}

# ---- RL state ---------------------------------------------------------------
var g_baseline = 0; # f64 EMA reward baseline b
var g_b1t = 0;      # f64 running beta1^step (adam bias correction)
var g_b2t = 0;      # f64 running beta2^step

# 0.9
fn ADAM_B1(): i64 { return f64_div(f64_from(9), f64_from(10)); }
# 0.999
fn ADAM_B2(): i64 { return f64_div(f64_from(999), f64_from(1000)); }
# 1e-8
fn ADAM_EPS(): i64 { return f64_div(f64_from(1), f64_from(100000000)); }
# baseline EMA 0.9
fn RL_BETA(): i64 { return f64_div(f64_from(9), f64_from(10)); }

# Allocate + initialize. E,W ~ small Gaussian (tyche via t_randn); b = 0. Seeds
# the RNG so a run is reproducible.
fn pol_init(V, D, T, target, seed): i64 {
    guard((V >= 1) && (D >= 1) && (T >= 1), "pol_init: V, D and T must be >= 1");
    g_V = V; g_D = D; g_T = T; g_target = target;
    rng_seed(seed);
    P_E = t_alloc(V * D); P_W = t_alloc(D * V); P_b = t_alloc(V);
    G_E = t_alloc(V * D); G_W = t_alloc(D * V); G_b = t_alloc(V);
    M_E = t_alloc(V * D); V_E = t_alloc(V * D);
    M_W = t_alloc(D * V); V_W = t_alloc(D * V);
    M_b = t_alloc(V);     V_b = t_alloc(V);
    S_logits = t_alloc(V); S_probs = t_alloc(V); S_demb = t_alloc(D);
    R_states = t_alloc(T); R_actions = t_alloc(T);
    PM_probs = t_alloc(V * V); PM_stamp = t_alloc(V); t_zero(PM_stamp, V);
    PM_epoch = PM_epoch + 1;                 # new parameters: no cached row is valid
    PB_rows = t_alloc(V * V); PB_list = t_alloc(V); PB_mark = t_alloc(V); PB_n = 0;
    # small init so early logits are near-uniform
    t_randn(P_E, V * D, f64_div(f64_from(1), f64_from(10)));   # std 0.1
    t_randn(P_W, D * V, f64_div(f64_from(1), f64_from(10)));
    t_zero(P_b, V);
    g_baseline = f64_from(0);
    g_b1t = f64_from(1); g_b2t = f64_from(1);
    return 0;
}

# logits for state token x -> S_logits  (emb = E[x]; logits = emb @ W + b)
fn pol_logits(x): i64 {
    guard((x >= 0) && (x < g_V), "pol_logits: state token out of range (0..V-1)");
    linear_fwd(P_E + x * g_D * 8, P_W, P_b, S_logits, 1, g_D, g_V);
    return 0;
}

# The one softmax kernel: probs[0..V) = softmax(logits[0..V)), max-shifted so exp never
# overflows, then normalized by one reciprocal. pol_softmax (the policy) and ref_softmax
# (the frozen reference, src/dpo.cyr) both run it.
fn softmax_into(logits, probs): i64 {
    var mx = load64(logits);
    var v = 1;
    while (v < g_V) {
        var lv = load64(logits + v * 8);
        if (f64_gt(lv, mx) == 1) { mx = lv; }
        v = v + 1;
    }
    var sum = f64_from(0);
    v = 0;
    while (v < g_V) {
        var e = f64_exp(f64_sub(load64(logits + v * 8), mx));
        store64(probs + v * 8, e);
        sum = f64_add(sum, e);
        v = v + 1;
    }
    var inv = f64_div(f64_from(1), sum);
    v = 0;
    while (v < g_V) {
        store64(probs + v * 8, f64_mul(load64(probs + v * 8), inv));
        v = v + 1;
    }
    return 0;
}

# softmax(S_logits) -> S_probs
fn pol_softmax(): i64 { return softmax_into(S_logits, S_probs); }

# forward-only cross-entropy -ln pi(a | x) for one (state, action). No gradient —
# the finite-difference grad-check perturbs a weight and calls this.
fn pol_ce(x, a): i64 {
    pol_logits(x); pol_softmax();
    return f64_neg(f64_ln(load64(S_probs + a * 8)));
}

# sample a token from S_probs (already softmaxed) via the cumulative distribution
fn pol_sample(): i64 {
    var r = rng_uniform();               # f64 in [0,1)
    var cum = f64_from(0);
    var v = 0;
    while (v < g_V) {
        cum = f64_add(cum, load64(S_probs + v * 8));
        if (f64_lt(r, cum) == 1) { return v; }
        v = v + 1;
    }
    return g_V - 1;
}

# a rollout start state. When a corpus is loaded via akshara (g_datalen > 0), draw a
# real token from it (gd_ld at a random index) — diverse on-policy contexts grounded
# in actual text, exactly attn11's rl_prompt. Otherwise fall back to a uniform random
# token over the synthetic vocab (used by the grad-check tests, which load no corpus).
fn rl_prompt(): i64 {
    if (g_datalen > 0) { return gd_ld((rng_u64() & 0x7FFFFFFFFFFFFFFF) % g_datalen); }
    return (rng_u64() & 0x7FFFFFFFFFFFFFFF) % g_V;
}

# sample an on-policy rollout of g_T actions; lay out (state_t, action_t) pairs.
# x_0 = prompt; x_{t+1} sampled from pi(.|x_t) at temp 1 (on-policy: the sampling
# distribution equals the one the gradient differentiates).
fn rl_rollout(prompt): i64 {
    var x = prompt;
    var t = 0;
    while (t < g_T) {
        store64(R_states + t * 8, x);
        pol_dist(x);
        var a = pol_sample();
        store64(R_actions + t * 8, a);
        x = a;
        t = t + 1;
    }
    return 0;
}

# reward: count of sampled actions equal to the target token (f64). Monotone,
# demonstrable — REINFORCE should raise the target's sample frequency.
fn rl_reward(): i64 {
    var c = 0;
    var t = 0;
    while (t < g_T) {
        if (load64(R_actions + t * 8) == g_target) { c = c + 1; }
        t = t + 1;
    }
    return f64_from(c);
}

# zero the policy gradient accumulators G_E / G_W / G_b
# zero the policy gradient accumulators G_E / G_W / G_b, and drop any deferred rows
fn pol_zero_grads(): i64 {
    pol_bwd_discard();
    t_zero(G_E, g_V * g_D); t_zero(G_W, g_D * g_V); t_zero(G_b, g_V);
    return 0;
}

# scale the policy gradient accumulators by s (the 1/batch mean before an Adam step),
# after applying the deferred rows
fn pol_scale_grads(s): i64 {
    pol_bwd_flush();
    t_scale(G_E, g_V * g_D, s); t_scale(G_W, g_D * g_V, s); t_scale(G_b, g_V, s);
    return 0;
}

# ---- the aggregated backward (1.3.0) ------------------------------------------------
# Every token of one state x shares the embedding row E[x], so the backward is linear in
# the seed: the sum over x's tokens of linear_bwd(E[x], seed_t) is linear_bwd(E[x], the sum
# of the seeds). Inside a memo region (tarka's own training loops) pol_bwd_seeded therefore
# adds each seed into a pending row for its state, and pol_bwd_flush runs ONE linear_bwd
# per touched state, in first-touch order, when the gradient is next needed
# (pol_scale_grads, pol_adam_step). A REINFORCE step at V 28 runs 28 backwards instead of
# 384. The sums are reordered, so the bits differ from the per-token backward — a labeled
# behavior change (ADR 0002). Outside a region the backward stays immediate, so a caller
# that reads G_* right after a backward (the grad-checks) sees it at once.
var PB_rows = 0;    # V*V  the pending sum of seeds, row x
var PB_list = 0;    # V    the states with a pending row, in first-touch order
var PB_mark = 0;    # V    1 while state x has a pending row
var PB_n = 0;       # how many states have a pending row

# S_probs holds the seed dlogits for state x: back-propagate it into G_* now, or (inside
# a memo region) add it to x's pending row
fn pol_bwd_seeded(x): i64 {
    if (g_memo_depth == 0) {
        linear_bwd(P_E + x * g_D * 8, P_W, S_probs, S_demb, G_W, G_b, 1, g_D, g_V);
        t_add_into(G_E + x * g_D * 8, S_demb, g_D);
        return 0;
    }
    if (load64(PB_mark + x * 8) == 0) {
        store64(PB_mark + x * 8, 1);
        store64(PB_list + PB_n * 8, x);
        PB_n = PB_n + 1;
    }
    t_add_into(PB_rows + x * g_V * 8, S_probs, g_V);
    return 0;
}

# apply every pending row: one linear_bwd per touched state, then clear it
fn pol_bwd_flush(): i64 {
    var i = 0;
    while (i < PB_n) {
        var x = load64(PB_list + i * 8);
        var row = PB_rows + x * g_V * 8;
        linear_bwd(P_E + x * g_D * 8, P_W, row, S_demb, G_W, G_b, 1, g_D, g_V);
        t_add_into(G_E + x * g_D * 8, S_demb, g_D);
        t_zero(row, g_V);
        store64(PB_mark + x * 8, 0);
        i = i + 1;
    }
    PB_n = 0;
    return 0;
}

# drop every pending row unapplied (pol_zero_grads starts the gradient over)
fn pol_bwd_discard(): i64 {
    var i = 0;
    while (i < PB_n) {
        var x = load64(PB_list + i * 8);
        t_zero(PB_rows + x * g_V * 8, g_V);
        store64(PB_mark + x * 8, 0);
        i = i + 1;
    }
    PB_n = 0;
    return 0;
}

# The one softmax-policy backward step. With S_probs = pi(.|x) already computed for
# state x, turn S_probs into the seed dlogits = (probs - onehot(a)) * X in place, run
# rosnet's linear_bwd (G_W, G_b += emb^T @ dlogits; S_demb = dlogits @ W^T) and scatter
# S_demb into G_E[x]. Every policy gradient in tarka ends here: X is the advantage
# (REINFORCE), the clipped-surrogate coefficient (PPO / GRPO), or a preference loss's
# coefficient (DPO / IPO / KTO). Since grad log pi(a|x) = -grad CE(a), the seed IS the
# policy gradient, with no new backward math.
fn pol_seed_bwd(x, a, X): i64 {
    guard((a >= 0) && (a < g_V), "pol_seed_bwd: action token out of range (0..V-1)");
    store64(S_probs + a * 8, f64_sub(load64(S_probs + a * 8), f64_from(1)));
    t_scale(S_probs, g_V, X);
    pol_bwd_seeded(x);
    return 0;
}

# Accumulate the (scaled) policy gradient of the current rollout into G_*: at each step,
# recompute pi(.|x_t) and run pol_seed_bwd with X = scale. With scale = advantage this is
# the REINFORCE gradient; with scale = 1 it is the plain softmax-CE gradient over the
# rollout (the grad-check baseline). Returns the rollout's summed CE (-log pi).
fn rl_backward(scale): i64 {
    var loss = f64_from(0);
    var t = 0;
    while (t < g_T) {
        var x = load64(R_states + t * 8);
        var a = load64(R_actions + t * 8);
        pol_dist(x);
        loss = f64_sub(loss, f64_ln(load64(S_probs + a * 8)));
        pol_seed_bwd(x, a, scale);
        t = t + 1;
    }
    return loss;
}

# The one Adam kernel (Kingma & Ba 2015) over n parameters, with bias-correction powers
# b1t = beta1^step and b2t = beta2^step supplied by the caller. The policy (adam_one) and
# the reward model (rm_adam_one) each keep their own powers and share this body.
fn adam_kernel(P, G, M, Vv, n, lr, b1t, b2t): i64 {
    var b1 = ADAM_B1(); var b2 = ADAM_B2(); var eps = ADAM_EPS();
    var bc1 = f64_sub(f64_from(1), b1t);
    var bc2 = f64_sub(f64_from(1), b2t);
    var om1 = f64_sub(f64_from(1), b1);          # (1-β1), (1-β2): loop-invariant — hoisted (0.9.0)
    var om2 = f64_sub(f64_from(1), b2);
    var i = 0;
    while (i < n) {
        var g = load64(G + i * 8);
        var m = f64_add(f64_mul(b1, load64(M + i * 8)), f64_mul(om1, g));
        var vv = f64_add(f64_mul(b2, load64(Vv + i * 8)), f64_mul(om2, f64_mul(g, g)));
        store64(M + i * 8, m); store64(Vv + i * 8, vv);
        var mhat = f64_div(m, bc1);
        var vhat = f64_div(vv, bc2);
        var step = f64_div(f64_mul(lr, mhat), f64_add(f64_sqrt(vhat), eps));
        store64(P + i * 8, f64_sub(load64(P + i * 8), step));
        i = i + 1;
    }
    return 0;
}

# Adam update of one policy-side parameter block (the policy's powers g_b1t / g_b2t;
# the critic shares them, advanced in lockstep by pol_adam_step).
fn adam_one(P, G, M, Vv, n, lr): i64 { return adam_kernel(P, G, M, Vv, n, lr, g_b1t, g_b2t); }

# advance the policy's bias-correction powers one step, then Adam-update E, W and b
fn pol_adam_step(lr): i64 {
    pol_bwd_flush();                         # apply any deferred rows first
    PM_epoch = PM_epoch + 1;                 # the parameters change: retire cached rows
    g_b1t = f64_mul(g_b1t, ADAM_B1());
    g_b2t = f64_mul(g_b2t, ADAM_B2());
    adam_one(P_E, G_E, M_E, V_E, g_V * g_D, lr);
    adam_one(P_W, G_W, M_W, V_W, g_D * g_V, lr);
    adam_one(P_b, G_b, M_b, V_b, g_V, lr);
    return 0;
}

# REINFORCE training loop. Per step: zero grads; over the batch, sample a rollout,
# score it, set advantage = R - baseline, accumulate advantage-weighted CE grad;
# mean the grad over the batch; Adam step; update the EMA baseline AFTER the step
# (so a step's advantages use the average of PRIOR rewards). Returns mean reward of
# the last step.
fn rl_train(steps, batch, lr, log_every): i64 {
    guard(batch >= 1, "rl_train: batch must be >= 1 (0 scales the gradient by 1/0)");
    memo_begin();
    var invB = f64_div(f64_from(1), f64_from(batch));
    var meanR = f64_from(0);
    var s = 0;
    while (s < steps) {
        pol_zero_grads();
        var rsum = f64_from(0);
        var bi = 0;
        while (bi < batch) {
            rl_rollout(rl_prompt());
            var R = rl_reward();
            var adv = f64_sub(R, g_baseline);
            rl_backward(adv);                 # accumulate advantage-weighted grad
            rsum = f64_add(rsum, R);
            bi = bi + 1;
        }
        pol_scale_grads(invB);                # mean policy gradient over the batch
        pol_adam_step(lr);
        meanR = f64_mul(rsum, invB);
        g_baseline = f64_add(f64_mul(RL_BETA(), g_baseline),
          f64_mul(f64_sub(f64_from(1), RL_BETA()), meanR));
        s = s + 1;
    }
    memo_end();
    return meanR;
}

# mean reward over nroll fresh on-policy rollouts (no gradient) — the policy's
# current target-token sample frequency (the demonstrable RL metric).
fn rl_eval(nroll): i64 {
    guard(nroll >= 1, "rl_eval: nroll must be >= 1");
    memo_begin();
    var sum = f64_from(0);
    var k = 0;
    while (k < nroll) {
        rl_rollout(rl_prompt());
        sum = f64_add(sum, rl_reward());
        k = k + 1;
    }
    memo_end();
    return f64_div(sum, f64_from(nroll));
}
